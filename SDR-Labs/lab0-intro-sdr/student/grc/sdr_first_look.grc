options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Connect the RTL-SDR and look at the RF spectrum, waterfall and I/Q
      time waveform live (lab0-intro-sdr).
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: sdr_first_look
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: SDR First Look (RTL-SDR)
    window_size: (1200,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [152, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: freq
  id: variable_qtgui_range
  parameters:
    comment: "\u039A\u03B5\u03BD\u03C4\u03C1\u03B9\u03BA\u03AE \u03C3\u03C5\u03C7\u03BD\
      \u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03BF\u03C5 RTL-SDR"
    gui_hint: 0,0,1,1
    label: "\u03A3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C3\u03C5\u03BD\
      \u03C4\u03BF\u03BD\u03B9\u03C3\u03BC\u03BF\u03CD (MHz)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '24'
    step: '0.1'
    stop: '1700'
    value: '100.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 16.0]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: "\u039A\u03AD\u03C1\u03B4\u03BF\u03C2 (gain) \u03C4\u03BF\u03C5 RTL-SDR"
    gui_hint: 1,0,1,1
    label: "\u039A\u03AD\u03C1\u03B4\u03BF\u03C2 RF (dB)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '49'
    value: '30'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 24.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: RTL-SDR sample rate
    value: '2048000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 12]
    rotation: 0
    state: enabled
