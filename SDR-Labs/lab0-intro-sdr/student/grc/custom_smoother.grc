- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    \u03A0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1\
      \ custom block, \u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF \u03B5\u03BE\
      \ \u03BF\u03BB\u03BF\u03BA\u03BB\u03AE\u03C1\u03BF\u03C5 \u03C3\u03B5 Python:\
      \ \u03AD\u03BD\u03B1\u03C2\n    \u03B5\u03BE\u03BF\u03BC\u03B1\u03BB\u03C5\u03BD\
      \u03C4\u03AE\u03C2 \u03BA\u03B9\u03BD\u03B7\u03C4\u03BF\u03CD \u03BC\u03AD\u03C3\
      \u03BF\u03C5 \u03CC\u03C1\u03BF\u03C5 (moving-average smoother).\n\n    \u03A0\
      \u03B1\u03C1\u03AC\u03BC\u03B5\u03C4\u03C1\u03BF\u03C2:\n        window : \u03BC\
      \u03AE\u03BA\u03BF\u03C2 \u03C0\u03B1\u03C1\u03B1\u03B8\u03CD\u03C1\u03BF\u03C5\
      \ \u03B5\u03BE\u03BF\u03BC\u03AC\u03BB\u03C5\u03BD\u03C3\u03B7\u03C2 \u03C3\u03B5\
      \ \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1\u03C4\u03B1 (>= 1).\n\n    \u0394\u03B9\
      \u03B1\u03C4\u03B7\u03C1\u03B5\u03AF \u03C4\u03B1 \u03C4\u03B5\u03BB\u03B5\u03C5\
      \u03C4\u03B1\u03AF\u03B1 (window-1) \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1\u03C4\
      \u03B1 \u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\
      \u03BD\u03B7\u03C2 \u03BA\u03BB\u03AE\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5\n\
      \    work() \u03C9\u03C2 \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE\
      \ \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 (self.history), \u03CE\
      \u03C3\u03C4\u03B5 \u03B7 \u03B5\u03BE\u03BF\u03BC\u03AC\u03BB\u03C5\u03BD\u03C3\
      \u03B7 \u03BD\u03B1\n    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B5\
      \u03C7\u03AE\u03C2 \u03C3\u03C4\u03B1 \u03CC\u03C1\u03B9\u03B1 \u03B1\u03BD\u03AC\
      \u03BC\u03B5\u03C3\u03B1 \u03C3\u03B5 \u03B4\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\
      \u03BA\u03AC buffers -- \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C5\u03C4\u03CC\
      \ \u03B8\u03B1\n    \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\
      \u03B1\u03BD \u03C0\u03B1\u03C1\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03C3\u03B5\
      \u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE \u03BA\u03AC\u03B8\
      \u03B5 \u03BA\u03BB\u03AE\u03C3\u03B7\u03C2.\n    \"\"\"\n\n    def __init__(self,\
      \ window=5):\n        gr.sync_block.__init__(\n            self,\n         \
      \   name='\u0395\u03BE\u03BF\u03BC\u03B1\u03BB\u03C5\u03BD\u03C4\u03AE\u03C2\
      \ (\u03BA\u03B9\u03BD\u03B7\u03C4\u03CC\u03C2 \u03BC\u03AD\u03C3\u03BF\u03C2\
      )',\n            in_sig=[np.float32],\n            out_sig=[np.float32],\n \
      \       )\n        # \u0391\u03C0\u03BB\u03CC attribute -> \u03B3\u03AF\u03BD\
      \u03B5\u03C4\u03B1\u03B9 callback, \u03CE\u03C3\u03C4\u03B5 \u03C4\u03BF \u03C0\
      \u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF window\n        # \u03BD\u03B1 \u03B1\
      \u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03B6\u03C9\u03BD\u03C4\u03B1\u03BD\u03AC\
      \ \u03B1\u03C0\u03CC \u03C4\u03BF QT GUI Range widget.\n        self.window\
      \ = window\n        self.history = np.zeros(0, dtype=np.float32)\n\n    def\
      \ work(self, input_items, output_items):\n        x = input_items[0]\n     \
      \   w = max(1, int(self.window))\n        if len(self.history) != w - 1:\n \
      \           # \u0386\u03BB\u03BB\u03B1\u03BE\u03B5 \u03C4\u03BF \u03C0\u03B1\
      \u03C1\u03AC\u03B8\u03C5\u03C1\u03BF: \u03B5\u03C0\u03B1\u03BD\u03B1\u03C1\u03C7\
      \u03B9\u03BA\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BC\u03B5 \u03C4\u03BF \u03B9\
      \u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC (\u03BC\u03B5 \u03BC\u03B7\u03B4\u03B5\
      \u03BD\u03B9\u03BA\u03AC).\n            self.history = np.zeros(w - 1, dtype=np.float32)\n\
      \        buf = np.concatenate([self.history, x])\n        # \u039A\u03B9\u03BD\
      \u03B7\u03C4\u03CC\u03C2 \u03BC\u03AD\u03C3\u03BF\u03C2 \u03CC\u03C1\u03BF\u03C2\
      \ \u03BC\u03AD\u03C3\u03C9 \u03BA\u03C5\u03BB\u03B9\u03CC\u03BC\u03B5\u03BD\u03BF\
      \u03C5 \u03B1\u03B8\u03C1\u03BF\u03AF\u03C3\u03BC\u03B1\u03C4\u03BF\u03C2 (O(N),\
      \ \u03CC\u03C7\u03B9 O(N*w)).\n        cumsum = np.cumsum(np.insert(buf, 0,\
      \ 0.0))\n        y = (cumsum[w:] - cumsum[:-w]) / w\n        self.history =\
      \ buf[-(w - 1):] if w > 1 else np.zeros(0, dtype=np.float32)\n        output_items[0][:]\
      \ = y.astype(np.float32)\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    window: win_len
  states:
    _io_cache: "('\u0395\u03BE\u03BF\u03BC\u03B1\u03BB\u03C5\u03BD\u03C4\u03AE\u03C2\
      \ (\u03BA\u03B9\u03BD\u03B7\u03C4\u03CC\u03C2 \u03BC\u03AD\u03C3\u03BF\u03C2\
      )', 'blk', [('window', '5')], [('0', 'float', 1)], [('0', 'float', 1)], '\\\
      n    \u03A0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1 custom block,\
      \ \u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF \u03B5\u03BE \u03BF\u03BB\
      \u03BF\u03BA\u03BB\u03AE\u03C1\u03BF\u03C5 \u03C3\u03B5 Python: \u03AD\u03BD\
      \u03B1\u03C2\\n    \u03B5\u03BE\u03BF\u03BC\u03B1\u03BB\u03C5\u03BD\u03C4\u03AE\
      \u03C2 \u03BA\u03B9\u03BD\u03B7\u03C4\u03BF\u03CD \u03BC\u03AD\u03C3\u03BF\u03C5\
      \ \u03CC\u03C1\u03BF\u03C5 (moving-average smoother).\\n\\n    \u03A0\u03B1\u03C1\
      \u03AC\u03BC\u03B5\u03C4\u03C1\u03BF\u03C2:\\n        window : \u03BC\u03AE\u03BA\
      \u03BF\u03C2 \u03C0\u03B1\u03C1\u03B1\u03B8\u03CD\u03C1\u03BF\u03C5 \u03B5\u03BE\
      \u03BF\u03BC\u03AC\u03BB\u03C5\u03BD\u03C3\u03B7\u03C2 \u03C3\u03B5 \u03B4\u03B5\
      \u03AF\u03B3\u03BC\u03B1\u03C4\u03B1 (>= 1).\\n\\n    \u0394\u03B9\u03B1\u03C4\
      \u03B7\u03C1\u03B5\u03AF \u03C4\u03B1 \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\
      \u03AF\u03B1 (window-1) \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1\u03C4\u03B1 \u03C4\
      \u03B7\u03C2 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7\
      \u03C2 \u03BA\u03BB\u03AE\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5\\n    work()\
      \ \u03C9\u03C2 \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE \u03BA\
      \u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 (self.history), \u03CE\u03C3\
      \u03C4\u03B5 \u03B7 \u03B5\u03BE\u03BF\u03BC\u03AC\u03BB\u03C5\u03BD\u03C3\u03B7\
      \ \u03BD\u03B1\\n    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B5\
      \u03C7\u03AE\u03C2 \u03C3\u03C4\u03B1 \u03CC\u03C1\u03B9\u03B1 \u03B1\u03BD\u03AC\
      \u03BC\u03B5\u03C3\u03B1 \u03C3\u03B5 \u03B4\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\
      \u03BA\u03AC buffers -- \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C5\u03C4\u03CC\
      \ \u03B8\u03B1\\n    \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\
      \u03B1\u03BD \u03C0\u03B1\u03C1\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03C3\u03B5\
      \u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE \u03BA\u03AC\u03B8\
      \u03B5 \u03BA\u03BB\u03AE\u03C3\u03B7\u03C2.\\n    ', ['window'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [712, 376.0]
    rotation: 0
    state: enabled
