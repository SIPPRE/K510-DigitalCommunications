options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'First GNU Radio flowgraph for lab0-intro-sdr: a tone generator with
      time/frequency plots and audio output. No SDR required.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hello_world
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Hello, GNU Radio!
    window_size: (1200,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: Audio sample rate
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 12]
    rotation: 0
    state: enabled
- name: tone_amp
  id: variable_qtgui_range
  parameters:
    comment: "\u03A0\u03BB\u03AC\u03C4\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B7\u03BC\
      \u03B9\u03C4\u03CC\u03BD\u03BF\u03C5"
    gui_hint: 1,0,1,1
    label: "\u03A0\u03BB\u03AC\u03C4\u03BF\u03C2"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.1'
    step: '0.05'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 108]
    rotation: 0
    state: enabled
- name: tone_freq
  id: variable_qtgui_range
  parameters:
    comment: "\u03A3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03BF\u03C5\
      \ \u03B7\u03BC\u03B9\u03C4\u03CC\u03BD\u03BF\u03C5"
    gui_hint: 0,0,1,1
    label: "\u03A3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03CC\u03BD\
      \u03BF\u03C5 (Hz)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '100'
    step: '10'
    stop: '2000'
    value: '440'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 108]
    rotation: 0
    state: enabled
