    bus_source: false
    bus_structure: null
    coordinate: [1320, 368.0]
    rotation: 0
    state: enabled
- name: qtgui_tab_widget_0
  id: qtgui_tab_widget
  parameters:
    alias: ''
    comment: ''
    gui_hint: 1,0,1,4
    label0: "\u03A6\u03AC\u03C3\u03BC\u03B1 (\u03BC\u03B5\u03C4\u03AC \u03C4\u03B7\
