- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    \u039A\u03B2\u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03AE\u03C2\
      \ (mid-rise \u03BF\u03BC\u03BF\u03B9\u03CC\u03BC\u03BF\u03C1\u03C6\u03BF\u03C2\
      \ \u03BA\u03B2\u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03AE\u03C2) \u03C3\u03C4\
      \u03BF \u03B4\u03B9\u03AC\u03C3\u03C4\u03B7\u03BC\u03B1 [-1, 1).\n\n    \u03A0\
      \u03B1\u03C1\u03AC\u03BC\u03B5\u03C4\u03C1\u03BF\u03C2:\n        bits : \u03B1\
      \u03C1\u03B9\u03B8\u03BC\u03CC\u03C2 bits \u03BA\u03B2\u03AC\u03BD\u03C4\u03B9\
      \u03C3\u03B7\u03C2  ->  \u03C0\u03BB\u03AE\u03B8\u03BF\u03C2 \u03C3\u03C4\u03B1\
      \u03B8\u03BC\u03CE\u03BD = 2**bits.\n\n    \u0393\u03B9\u03B1 \u03BA\u03AC\u03B8\
      \u03B5 \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1 x:\n        1) \u03A0\u03B5\u03C1\
      \u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 (clipping) \u03C4\u03BF\u03C5\
      \ x \u03C3\u03C4\u03BF [-1, 1).\n        2) levels = 2**bits,   \u03B2\u03AE\
      \u03BC\u03B1 \u03BA\u03B2\u03AC\u03BD\u03C4\u03B9\u03C3\u03B7\u03C2 = 2/levels.\n\
      \        3) out = (floor(x * levels/2) + 0.5) * 2/levels\n           -> mid-rise:\
      \ \u03BA\u03B1\u03BC\u03AF\u03B1 \u03C3\u03C4\u03AC\u03B8\u03BC\u03B7 \u03B1\
      \u03BA\u03C1\u03B9\u03B2\u03CE\u03C2 \u03C3\u03C4\u03BF 0, \u03C3\u03C5\u03BC\
      \u03BC\u03B5\u03C4\u03C1\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C4\u03AC\u03B8\u03BC\
      \u03B5\u03C2.\n\n    \u038C\u03C3\u03BF \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\
      \u03C1\u03B1 bits, \u03C4\u03CC\u03C3\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\
      \u03C4\u03B5\u03C1\u03BF \u03C4\u03BF \u03B2\u03AE\u03BC\u03B1 \u03BA\u03B1\u03B9\
      \ \u03BF \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF\u03C2 \u03BA\u03B2\u03AC\u03BD\
      \u03C4\u03B9\u03C3\u03B7\u03C2,\n    \u03AC\u03C1\u03B1 \u03BC\u03B9\u03BA\u03C1\
      \u03CC\u03C4\u03B5\u03C1\u03BF SQNR (~6.02*bits + 1.76 dB \u03B3\u03B9\u03B1\
      \ \u03B7\u03BC\u03AF\u03C4\u03BF\u03BD\u03BF \u03C0\u03BB\u03AE\u03C1\u03BF\u03C5\
      \u03C2 \u03BA\u03BB\u03AF\u03BC\u03B1\u03BA\u03B1\u03C2).\n    \"\"\"\n\n  \
      \  def __init__(self, bits=8):\n        gr.sync_block.__init__(\n          \
      \  self,\n            name='\u039A\u03B2\u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\
      \u03AE\u03C2',\n            in_sig=[np.float32],\n            out_sig=[np.float32],\n\
      \        )\n        # \u0391\u03C0\u03BB\u03CC attribute -> \u03B3\u03AF\u03BD\
      \u03B5\u03C4\u03B1\u03B9 callback, \u03CE\u03C3\u03C4\u03B5 \u03C4\u03BF \u03C0\
      \u03BB\u03AE\u03B8\u03BF\u03C2 bits \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03B6\
      \u03B5\u03B9\n        # \u03B6\u03C9\u03BD\u03C4\u03B1\u03BD\u03AC \u03B1\u03C0\
      \u03CC \u03C4\u03BF QT GUI Range widget \u03CC\u03C3\u03BF \u03C4\u03C1\u03AD\
      \u03C7\u03B5\u03B9 \u03C4\u03BF flowgraph.\n        self.bits = bits\n\n   \
      \ def work(self, input_items, output_items):\n        x = input_items[0]\n \
      \       levels = 2 ** int(self.bits)          # \u03C0\u03BB\u03AE\u03B8\u03BF\
      \u03C2 \u03C3\u03C4\u03B1\u03B8\u03BC\u03CE\u03BD \u03BA\u03B2\u03AC\u03BD\u03C4\
      \u03B9\u03C3\u03B7\u03C2\n        step = 2.0 / levels                   # \u03B2\
      \u03AE\u03BC\u03B1 \u03BA\u03B2\u03AC\u03BD\u03C4\u03B9\u03C3\u03B7\u03C2 \u0394\
      \n        # Clipping \u03C3\u03C4\u03BF [-1, 1): \u03BA\u03AC\u03BD\u03BF\u03C5\
      \u03BC\u03B5 \u03C4\u03BF \u03AC\u03BD\u03C9 \u03AC\u03BA\u03C1\u03BF \"\u03B1\
      \u03BD\u03BF\u03B9\u03C7\u03C4\u03CC\" \u03CE\u03C3\u03C4\u03B5 \u03C4\u03BF\
      \ x=1\n        # \u03BD\u03B1 \u03BC\u03B7 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\
      \u03C1\u03B3\u03B5\u03AF \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD \u03C3\
      \u03C4\u03AC\u03B8\u03BC\u03B7 \u03C5\u03C0\u03B5\u03C1\u03C7\u03B5\u03AF\u03BB\
      \u03B9\u03C3\u03B7\u03C2.\n        hi = np.nextafter(np.float32(1.0), np.float32(0.0))\n\
      \        xc = np.clip(x, -1.0, hi)\n        # Mid-rise \u03BF\u03BC\u03BF\u03B9\
      \u03CC\u03BC\u03BF\u03C1\u03C6\u03B7 \u03BA\u03B2\u03AC\u03BD\u03C4\u03B9\u03C3\
      \u03B7, \u03B4\u03B9\u03B1\u03BD\u03C5\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC\
      \ \u03BC\u03B5 numpy.\n        codes = np.floor(xc * (levels / 2.0))\n     \
      \   y = (codes + 0.5) * step\n        output_items[0][:] = y.astype(np.float32)\n\
      \        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    bits: q_bits
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('\u039A\u03B2\u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03AE\u03C2', 'blk',\
      \ [('bits', '8')], [('0', 'float', 1)], [('0', 'float', 1)], '\\n    \u039A\u03B2\
      \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03AE\u03C2 (mid-rise \u03BF\u03BC\u03BF\
      \u03B9\u03CC\u03BC\u03BF\u03C1\u03C6\u03BF\u03C2 \u03BA\u03B2\u03B1\u03BD\u03C4\
      \u03B9\u03C3\u03C4\u03AE\u03C2) \u03C3\u03C4\u03BF \u03B4\u03B9\u03AC\u03C3\u03C4\
      \u03B7\u03BC\u03B1 [-1, 1).\\n\\n    \u03A0\u03B1\u03C1\u03AC\u03BC\u03B5\u03C4\
      \u03C1\u03BF\u03C2:\\n        bits : \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC\u03C2\
      \ bits \u03BA\u03B2\u03AC\u03BD\u03C4\u03B9\u03C3\u03B7\u03C2  ->  \u03C0\u03BB\
      \u03AE\u03B8\u03BF\u03C2 \u03C3\u03C4\u03B1\u03B8\u03BC\u03CE\u03BD = 2**bits.\\\
      n\\n    \u0393\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B5\u03AF\u03B3\
      \u03BC\u03B1 x:\\n        1) \u03A0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\
      \u03BC\u03CC\u03C2 (clipping) \u03C4\u03BF\u03C5 x \u03C3\u03C4\u03BF [-1, 1).\\\
      n        2) levels = 2**bits,   \u03B2\u03AE\u03BC\u03B1 \u03BA\u03B2\u03AC\u03BD\
      \u03C4\u03B9\u03C3\u03B7\u03C2 = 2/levels.\\n        3) out = (floor(x * levels/2)\
      \ + 0.5) * 2/levels\\n           -> mid-rise: \u03BA\u03B1\u03BC\u03AF\u03B1\
      \ \u03C3\u03C4\u03AC\u03B8\u03BC\u03B7 \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2\
      \ \u03C3\u03C4\u03BF 0, \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03C1\u03B9\u03BA\
      \u03AD\u03C2 \u03C3\u03C4\u03AC\u03B8\u03BC\u03B5\u03C2.\\n\\n    \u038C\u03C3\
      \u03BF \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03B1 bits, \u03C4\u03CC\u03C3\
      \u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF \u03C4\u03BF\
      \ \u03B2\u03AE\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BF \u03B8\u03CC\u03C1\u03C5\
      \u03B2\u03BF\u03C2 \u03BA\u03B2\u03AC\u03BD\u03C4\u03B9\u03C3\u03B7\u03C2,\\\
      n    \u03AC\u03C1\u03B1 \u03BC\u03B9\u03BA\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF\
      \ SQNR (~6.02*bits + 1.76 dB \u03B3\u03B9\u03B1 \u03B7\u03BC\u03AF\u03C4\u03BF\
      \u03BD\u03BF \u03C0\u03BB\u03AE\u03C1\u03BF\u03C5\u03C2 \u03BA\u03BB\u03AF\u03BC\
      \u03B1\u03BA\u03B1\u03C2).\\n    ', ['bits'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [712, 304.0]
    rotation: 0
    state: enabled
