- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    \u0394\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\
      \u03C2 / \u0391\u03C0\u03BF\u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\
      \u03AE\u03C2 \u0394\u03AD\u03BB\u03C4\u03B1 (Delta Modulation, DM).\n\n    \u03A0\
      \u03B1\u03C1\u03AC\u03BC\u03B5\u03C4\u03C1\u03BF\u03C2:\n        delta : \u03B2\
      \u03AE\u03BC\u03B1 (step size) \u03C4\u03BF\u03C5 \u03BF\u03BB\u03BF\u03BA\u03BB\
      \u03B7\u03C1\u03C9\u03C4\u03AE.\n\n    \u0393\u03B9\u03B1 \u03BA\u03AC\u03B8\
      \u03B5 \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1 x[n], \u03BC\u03B5 \xAB\u03BA\u03B1\
      \u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\xBB = \u03C4\u03C1\u03AD\u03C7\u03BF\
      \u03C5\u03C3\u03B1 \u03C4\u03B9\u03BC\u03AE \u03C4\u03BF\u03C5 \u03BF\u03BB\u03BF\
      \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE (\u03C3\u03BA\u03AC\u03BB\u03B1):\n\
      \        1) bit = +1 \u03B1\u03BD x[n] >= \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\
      \u03B1\u03C3\u03B7, \u03B1\u03BB\u03BB\u03B9\u03CE\u03C2 -1  (\u03C3\u03CD\u03B3\
      \u03BA\u03C1\u03B9\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BF\u03BB\u03BF\
      \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE)\n        2) \u03BA\u03B1\u03C4\u03AC\
      \u03C3\u03C4\u03B1\u03C3\u03B7 += bit * delta                  (\u03BF\u03BB\
      \u03BF\u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \xB1delta)\n\n    \u0388\u03BE\
      \u03BF\u03B4\u03BF\u03B9:\n        out0 : \u03B7 \u03C1\u03BF\u03AE bits \u03C9\
      \u03C2 \xB11 (float)\n        out1 : \u03B7 \xAB\u03C3\u03BA\u03AC\u03BB\u03B1\
      \xBB \u03C4\u03BF\u03C5 \u03B1\u03C0\u03BF\u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\
      \u03C0\u03BF\u03B9\u03B7\u03C4\u03AE (\u03B7 \u03C4\u03B9\u03BC\u03AE \u03C4\
      \u03BF\u03C5 \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE)\xB7\
      \ \u03C3\u03B5 \u03B9\u03B4\u03B1\u03BD\u03B9\u03BA\u03AE\n               DM\
      \ \u03BF \u03B1\u03C0\u03BF\u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03C0\u03BF\u03B9\
      \u03B7\u03C4\u03AE\u03C2 \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\
      \u03B9 \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2 \u03C4\u03BF\u03BD \u03BF\u03BB\
      \u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE \u03C4\u03BF\u03C5 \u03C0\u03BF\
      \u03BC\u03C0\u03BF\u03CD.\n\n    \u0397 DM \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\
      \u03BD\u03B1\u03B4\u03C1\u03BF\u03BC\u03B9\u03BA\u03AE (\u03BA\u03AC\u03B8\u03B5\
      \ \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\
      \u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\
      \u03CD\u03BC\u03B5\u03BD\u03BF), \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC \u03BF\
      \n    \u03C0\u03C5\u03C1\u03AE\u03BD\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9\
      \ \u03C3\u03B5\u03B9\u03C1\u03B9\u03B1\u03BA\u03CC\u03C2 \u03B2\u03C1\u03CC\u03C7\
      \u03BF\u03C2 \u03BA\u03B1\u03B9 \u0394\u0395\u039D \u03B4\u03B9\u03B1\u03BD\u03C5\
      \u03C3\u03BC\u03B1\u03C4\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9\
      \ \u03C0\u03BB\u03AE\u03C1\u03C9\u03C2 \u03BC\u03B5 numpy.\n\n    \u03A3\u03C5\
      \u03BC\u03C0\u03B5\u03C1\u03B9\u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03C5 \u03B8\
      \u03B1 \u03C0\u03B1\u03C1\u03B1\u03C4\u03B7\u03C1\u03AE\u03C3\u03B5\u03C4\u03B5\
      :\n      * \u039C\u03B9\u03BA\u03C1\u03CC delta  -> \u03C5\u03C0\u03B5\u03C1\
      \u03C6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03BA\u03BB\u03AF\u03C3\u03B7\u03C2\
      \ (slope overload) \u03C3\u03C4\u03B9\u03C2 \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\
      \u03B5\u03C2 \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2.\n     \
      \ * \u039C\u03B5\u03B3\u03AC\u03BB\u03BF delta -> \u03BA\u03BF\u03BA\u03BA\u03CE\
      \u03B4\u03B7\u03C2 \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF\u03C2 (granular noise)\
      \ \u03C3\u03C4\u03B1 \u03B1\u03C1\u03B3\u03AC/\u03C3\u03C4\u03B1\u03B8\u03B5\
      \u03C1\u03AC \u03C4\u03BC\u03AE\u03BC\u03B1\u03C4\u03B1.\n    \"\"\"\n\n   \
      \ def __init__(self, delta=0.05):\n        gr.sync_block.__init__(\n       \
      \     self, name='\u0394\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\
      \u03C2/\u0391\u03C0\u03BF\u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\
      \u03AE\u03C2 \u0394\u03AD\u03BB\u03C4\u03B1',\n            in_sig=[np.float32],\
      \ out_sig=[np.float32, np.float32])\n        # \u0391\u03C0\u03BB\u03AC attributes\
      \ -> \u03C4\u03BF delta \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 live callback\xB7\
      \ \u03C4\u03BF state \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF\u03C4\u03B1\
      \u03B9.\n        self.delta = delta\n        self.state = 0.0   # \u03C4\u03B9\
      \u03BC\u03AE \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE, \u03B4\
      \u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9 \u03BC\u03B5\u03C4\
      \u03B1\u03BE\u03CD \u03BA\u03BB\u03AE\u03C3\u03B5\u03C9\u03BD work()\n\n   \
      \ def work(self, input_items, output_items):\n        x = input_items[0]\n \
      \       bits = output_items[0]\n        stair = output_items[1]\n        state\
      \ = self.state\n        d = float(self.delta)\n        for i in range(len(x)):\n\
      \            b = 1.0 if x[i] >= state else -1.0   # bit \u03C0\u03C1\u03CC\u03C3\
      \u03B7\u03BC\u03BF\u03C5\n            state += b * d                       \
      \ # \u03BF\u03BB\u03BF\u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\n         \
      \   bits[i] = b\n            stair[i] = state\n        self.state = state\n\
      \        return len(x)\n"
    affinity: ''
    alias: ''
    comment: ''
    delta: delta
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('\u0394\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\u03C2\
      /\u0391\u03C0\u03BF\u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\
      \u03C2 \u0394\u03AD\u03BB\u03C4\u03B1', 'blk', [('delta', '0.05')], [('0', 'float',\
      \ 1)], [('0', 'float', 1), ('1', 'float', 1)], \"\\n    \u0394\u03B9\u03B1\u03BC\
      \u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\u03C2 / \u0391\u03C0\u03BF\u03B4\u03B9\u03B1\
      \u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\u03C2 \u0394\u03AD\u03BB\u03C4\u03B1\
      \ (Delta Modulation, DM).\\n\\n    \u03A0\u03B1\u03C1\u03AC\u03BC\u03B5\u03C4\
      \u03C1\u03BF\u03C2:\\n        delta : \u03B2\u03AE\u03BC\u03B1 (step size) \u03C4\
      \u03BF\u03C5 \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE.\\\
      n\\n    \u0393\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B5\u03AF\u03B3\
      \u03BC\u03B1 x[n], \u03BC\u03B5 \xAB\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\
      \u03C3\u03B7\xBB = \u03C4\u03C1\u03AD\u03C7\u03BF\u03C5\u03C3\u03B1 \u03C4\u03B9\
      \u03BC\u03AE \u03C4\u03BF\u03C5 \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\
      \u03C4\u03AE (\u03C3\u03BA\u03AC\u03BB\u03B1):\\n        1) bit = +1 \u03B1\u03BD\
      \ x[n] >= \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7, \u03B1\u03BB\
      \u03BB\u03B9\u03CE\u03C2 -1  (\u03C3\u03CD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7\
      \ \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\
      \u03C9\u03C4\u03AE)\\n        2) \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\
      \u03B7 += bit * delta                  (\u03BF\u03BB\u03BF\u03BA\u03BB\u03AE\
      \u03C1\u03C9\u03C3\u03B7 \xB1delta)\\n\\n    \u0388\u03BE\u03BF\u03B4\u03BF\u03B9\
      :\\n        out0 : \u03B7 \u03C1\u03BF\u03AE bits \u03C9\u03C2 \xB11 (float)\\\
      n        out1 : \u03B7 \xAB\u03C3\u03BA\u03AC\u03BB\u03B1\xBB \u03C4\u03BF\u03C5\
      \ \u03B1\u03C0\u03BF\u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03C0\u03BF\u03B9\u03B7\
      \u03C4\u03AE (\u03B7 \u03C4\u03B9\u03BC\u03AE \u03C4\u03BF\u03C5 \u03BF\u03BB\
      \u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE)\xB7 \u03C3\u03B5 \u03B9\u03B4\
      \u03B1\u03BD\u03B9\u03BA\u03AE\\n               DM \u03BF \u03B1\u03C0\u03BF\
      \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03C0\u03BF\u03B9\u03B7\u03C4\u03AE\u03C2\
      \ \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9 \u03B1\u03BA\u03C1\
      \u03B9\u03B2\u03CE\u03C2 \u03C4\u03BF\u03BD \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\
      \u03C1\u03C9\u03C4\u03AE \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BC\u03C0\u03BF\u03CD\
      .\\n\\n    \u0397 DM \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BD\u03B1\u03B4\
      \u03C1\u03BF\u03BC\u03B9\u03BA\u03AE (\u03BA\u03AC\u03B8\u03B5 \u03B4\u03B5\u03AF\
      \u03B3\u03BC\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\
      \u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\
      \u03BD\u03BF), \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC \u03BF\\n    \u03C0\u03C5\
      \u03C1\u03AE\u03BD\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03B5\u03B9\
      \u03C1\u03B9\u03B1\u03BA\u03CC\u03C2 \u03B2\u03C1\u03CC\u03C7\u03BF\u03C2 \u03BA\
      \u03B1\u03B9 \u0394\u0395\u039D \u03B4\u03B9\u03B1\u03BD\u03C5\u03C3\u03BC\u03B1\
      \u03C4\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C0\u03BB\u03AE\
      \u03C1\u03C9\u03C2 \u03BC\u03B5 numpy.\\n\\n    \u03A3\u03C5\u03BC\u03C0\u03B5\
      \u03C1\u03B9\u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03C0\u03B1\
      \u03C1\u03B1\u03C4\u03B7\u03C1\u03AE\u03C3\u03B5\u03C4\u03B5:\\n      * \u039C\
      \u03B9\u03BA\u03C1\u03CC delta  -> \u03C5\u03C0\u03B5\u03C1\u03C6\u03CC\u03C1\
      \u03C4\u03C9\u03C3\u03B7 \u03BA\u03BB\u03AF\u03C3\u03B7\u03C2 (slope overload)\
      \ \u03C3\u03C4\u03B9\u03C2 \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B5\u03C2\
      \ \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2.\\n      * \u039C\u03B5\
      \u03B3\u03AC\u03BB\u03BF delta -> \u03BA\u03BF\u03BA\u03BA\u03CE\u03B4\u03B7\
      \u03C2 \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF\u03C2 (granular noise) \u03C3\u03C4\
      \u03B1 \u03B1\u03C1\u03B3\u03AC/\u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AC \u03C4\
      \u03BC\u03AE\u03BC\u03B1\u03C4\u03B1.\\n    \", ['delta'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 360.0]
    rotation: 0
    state: enabled
