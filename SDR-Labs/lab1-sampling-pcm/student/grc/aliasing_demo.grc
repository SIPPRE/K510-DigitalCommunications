options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Aliasing & sampling-rate demonstration (simulation only, no hardware)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: aliasing_demo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Aliasing Demo (Dsigmatolipsia & Anakataskevi)
    window_size: (1200,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable_qtgui_chooser
  parameters:
    comment: Downsampling factor -> effective rate = samp_rate / N
    gui_hint: 0,2,1,1
    label: "\u03A1\u03C5\u03B8\u03BC\u03CC\u03C2 \u03B4\u03B5\u03B9\u03B3\u03BC\u03B1\
      \u03C4\u03BF\u03BB\u03B7\u03C8\u03AF\u03B1\u03C2"
    label0: 48 kHz (N=1)
    label1: 24 kHz (N=2)
    label2: 12 kHz (N=4)
    label3: 6 kHz (N=8)
    label4: ''
    labels: '[]'
    num_opts: '4'
    option0: '1'
    option1: '2'
    option2: '4'
    option3: '8'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: int
    value: '4'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 108]
    rotation: 0
    state: enabled
- name: audio_on
  id: variable_qtgui_check_box
  parameters:
    comment: Un-mute to hear the (aliased) reconstructed tone
    'false': '0'
    gui_hint: 0,3,1,1
    label: "\u0391\u03BD\u03B1\u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE \u03AE\
      \u03C7\u03BF\u03C5"
    'true': '1'
    type: int
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 108]
    rotation: 0
    state: enabled
- name: nyq
  id: variable
  parameters:
    comment: New Nyquist after downsampling
    value: samp_rate/(2*N)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 0.0]
    rotation: 0
    state: enabled
- name: rec_cutoff
  id: variable
  parameters:
    comment: Reconstruction LPF cutoff (just below new Nyquist)
    value: nyq*0.85
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 0.0]
    rotation: 0
    state: enabled
- name: rec_trans
  id: variable
  parameters:
    comment: Reconstruction LPF transition width
    value: nyq*0.2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1048, 0.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Base sample rate (fixed)
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 0.0]
    rotation: 0
    state: enabled
- name: sig_freq
  id: variable_qtgui_range
  parameters:
    comment: Frequency of the source cosine
    gui_hint: 0,0,1,2
    label: "\u03A3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C3\u03AE\u03BC\
      \u03B1\u03C4\u03BF\u03C2 (Hz)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '100'
    step: '100'
    stop: '24000'
    value: '5000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 120.0]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.5'
    comment: Original cosine (band-unlimited source)
    freq: sig_freq
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [136, 376.0]
    rotation: 0
    state: enabled
- name: audio_sink_0
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: Listen to the reconstructed (possibly aliased) tone
    device_name: ''
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 624.0]
    rotation: 0
    state: enabled
- name: blocks_keep_one_in_n_0
  id: blocks_keep_one_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: 'Sampling: keep 1 of every N samples (rate -> samp_rate/N)'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: N
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 504.0]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: Mute / un-mute gate for audio
    const: audio_on
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [936, 624.0]
    rotation: 0
    state: enabled
- name: blocks_repeat_0
  id: blocks_repeat
  parameters:
    affinity: ''
    alias: ''
    comment: 'Reconstruction: hold each sample N times (back to samp_rate)'
    interp: N
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 496.0]
    rotation: 0
    state: enabled
- name: blocks_throttle_0
  id: blocks_throttle
  parameters:
    affinity: ''
    alias: ''
    comment: Pace simulation at samp_rate
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 400.0]
    rotation: 0
    state: enabled
- name: low_pass_filter_0
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: Reconstruction LPF at the new Nyquist
    cutoff_freq: rec_cutoff
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_fff
    width: rec_trans
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [936, 488.0]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.1'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: Original vs reconstructed spectrum
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: qtgui_tab_widget_0@1
    label: Relative Gain
    label1: "\u0391\u03C1\u03C7\u03B9\u03BA\u03CC \u03C3\u03AE\u03BC\u03B1"
    label10: ''''''
    label2: "\u0391\u03BD\u03B1\u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03B1\
      \u03C3\u03BC\u03AD\u03BD\u03BF (alias)"
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
