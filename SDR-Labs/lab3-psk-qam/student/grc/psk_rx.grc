- name: snippet_square_const
  id: snippet
  parameters:
    alias: ''
    code: "# \u039A\u03C1\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2 \u03B1\u03C3\u03C4\
      \u03B5\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2 \u03A4\u0395\u03A4\u03A1\u0391\
      \u0393\u03A9\u039D\u039F\u03A5\u03A3 (\u03AF\u03C3\u03B7 \u03BA\u03BB\u03AF\u03BC\
      \u03B1\u03BA\u03B1 \u03C3\u03C4\u03BF\u03C5\u03C2 \u03AC\u03BE\u03BF\u03BD\u03B5\
      \u03C2 I \u03BA\u03B1\u03B9 Q),\n# \u03CC\u03C0\u03BF\u03B9\u03BF \u03BC\u03AD\
      \u03B3\u03B5\u03B8\u03BF\u03C2 \u03BA\u03B9 \u03B1\u03BD \u03AD\u03C7\u03B5\u03B9\
      \ \u03C4\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF (\u03C0.\u03C7\
      . \u03C3\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7 \u03BF\u03B8\u03CC\u03BD\u03B7\
      ).\n# \u03A4\u03BF QT GUI Constellation Sink \u03B4\u03B5\u03BD \u03AD\u03C7\
      \u03B5\u03B9 \u03C4\u03AD\u03C4\u03BF\u03B9\u03B1 \u03B5\u03C0\u03B9\u03BB\u03BF\
      \u03B3\u03AE, \u03BF\u03C0\u03CC\u03C4\u03B5 \u03BA\u03AC\u03B8\u03B5\n# \u03B1\
      \u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C4\u03C5\u03BB\u03AF\
      \u03B3\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03C0\u03BB\u03B1\
      \u03AF\u03C3\u03B9\u03BF \u03C0\u03BF\u03C5 \u03C4\u03BF\u03BD \u03BA\u03B5\u03BD\
      \u03C4\u03C1\u03AC\u03C1\u03B5\u03B9 \u03BA\u03B1\u03B9 \u03BA\u03C1\u03B1\u03C4\
      \u03AC\n# \u03C4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03B7 \u03C4\u03B7\
      \u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03C3\u03C7\u03B5\u03B4\u03AF\
      \u03B1\u03C3\u03B7\u03C2 (canvas) \u03C4\u03BF\u03C5 \u03B3\u03C1\u03B1\u03C6\
      \u03AE\u03BC\u03B1\u03C4\u03BF\u03C2.\nfrom PyQt5 import Qt, QtCore\n\nclass\
      \ SquarePlot(Qt.QWidget):\n    def __init__(self, inner):\n        Qt.QWidget.__init__(self)\n\
      \        self.inner = inner\n        self.setMinimumSize(260, 260)\n       \
      \ self.setSizePolicy(Qt.QSizePolicy.Expanding, Qt.QSizePolicy.Expanding)\n\n\
      \    def sizeHint(self):\n        return QtCore.QSize(480, 480)\n\n    def canvas(self):\n\
      \        for w in self.inner.findChildren(Qt.QWidget):\n            if w.metaObject().className()\
      \ == 'QwtPlotCanvas':\n                return w\n        return None\n\n   \
      \ def fit(self):\n        # \u03C0\u03B5\u03C1\u03B9\u03B8\u03CE\u03C1\u03B9\
      \u03B1 = \u03C4\u03AF\u03C4\u03BB\u03BF\u03C2, \u03AC\u03BE\u03BF\u03BD\u03B5\
      \u03C2, \u03C5\u03C0\u03CC\u03BC\u03BD\u03B7\u03BC\u03B1 (\u03CC,\u03C4\u03B9\
      \ \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 canvas)\n        mw = mh\
      \ = 0\n        c = self.canvas()\n        if c is not None and c.width() > 1\
      \ and c.height() > 1:\n            mw = self.inner.width() - c.width()\n   \
      \         mh = self.inner.height() - c.height()\n        side = max(50, min(self.width()\
      \ - mw, self.height() - mh))\n        w, h = side + mw, side + mh\n        self.inner.setGeometry((self.width()\
      \ - w) // 2,\n                               (self.height() - h) // 2, w, h)\n\
      \n    def resizeEvent(self, event):\n        self.fit()\n        # \u03B4\u03B5\
      \u03CD\u03C4\u03B5\u03C1\u03BF \u03C0\u03AD\u03C1\u03B1\u03C3\u03BC\u03B1, \u03B1\
      \u03C6\u03BF\u03CD \u03C4\u03BF \u03B3\u03C1\u03AC\u03C6\u03B7\u03BC\u03B1 \u03BE\
      \u03B1\u03BD\u03B1\u03CB\u03C0\u03BF\u03BB\u03BF\u03B3\u03AF\u03C3\u03B5\u03B9\
      \ \u03C4\u03B1 \u03C0\u03B5\u03C1\u03B9\u03B8\u03CE\u03C1\u03B9\u03AC \u03C4\
      \u03BF\u03C5\n        QtCore.QTimer.singleShot(0, self.fit)\n        QtCore.QTimer.singleShot(100,\
      \ self.fit)\n\ndef find_layout(layout, widget):\n    for i in range(layout.count()):\n\
      \        item = layout.itemAt(i)\n        if item.widget() is widget:\n    \
      \        return layout\n        if item.layout() is not None:\n            found\
      \ = find_layout(item.layout(), widget)\n            if found is not None:\n\
      \                return found\n    return None\n\nself._square_plots = []\n\
      for name in sorted(vars(self)):\n    if not (name.startswith('_qtgui_const_sink_x')\
      \ and name.endswith('_win')):\n        continue\n    win = getattr(self, name)\n\
      \    parent = win.parentWidget()\n    layout = find_layout(parent.layout(),\
      \ win) if parent is not None else None\n    if layout is None:\n        continue\n\
      \    box = SquarePlot(win)\n    layout.replaceWidget(win, box)\n    win.setParent(box)\n\
      \    win.show()\n    self._square_plots.append(box)\n    # \u03A3\u03C4\u03BF\
      \ \u03C0\u03BB\u03AD\u03B3\u03BC\u03B1: \u03B7 \u03B3\u03C1\u03B1\u03BC\u03BC\
      \u03AE \u03C4\u03C9\u03BD \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03CE\
      \u03BD \u03C0\u03B1\u03AF\u03C1\u03BD\u03B5\u03B9 \u03C4\u03BF \u03C0\u03B5\u03C1\
      \u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF \u03CD\u03C8\u03BF\u03C2,\n\
      \    # \u03BF\u03B9 \u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03C2 \u03BC\u03B5\
      \ \u03BF\u03BB\u03B9\u03C3\u03B8\u03B7\u03C4\u03AE\u03C1\u03B5\u03C2 \u03BC\u03CC\
      \u03BD\u03BF \u03CC\u03C3\u03BF \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\
      \u03C4\u03B1\u03B9.\n    if isinstance(layout, Qt.QGridLayout):\n        plots\
      \ = [getattr(self, n) for n in vars(self)\n                 if n.startswith('_qtgui_')\
      \ and n.endswith('_win')\n                 and 'number_sink' not in n and 'const_sink'\
      \ not in n]\n        for i in range(layout.count()):\n            row = layout.getItemPosition(i)[0]\n\
      \            w = layout.itemAt(i).widget()\n            if isinstance(w, SquarePlot):\n\
      \                layout.setRowStretch(row, 3)\n            elif any(w is p for\
      \ p in plots):\n                layout.setRowStretch(row, 2)\n            elif\
      \ layout.rowStretch(row) == 1:\n                layout.setRowStretch(row, 0)"
    comment: "\u03A4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF\u03B9 \u03B1\u03C3\
      \u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03BF\u03AF: \u03BA\u03C1\u03B1\u03C4\u03AC\
      \ \u03AF\u03C3\u03B7 \u03BA\u03BB\u03AF\u03BC\u03B1\u03BA\u03B1 I/Q \u03C3\u03B5\
      \ \u03BA\u03AC\u03B8\u03B5 \u03BC\u03AD\u03B3\u03B5\u03B8\u03BF\u03C2 \u03C0\
      \u03B1\u03C1\u03B1\u03B8\u03CD\u03C1\u03BF\u03C5 (\u03BA\u03B1\u03B9 \u03C3\u03B5\
      \ \u03C0\u03BB\u03AE\u03C1\u03B7 \u03BF\u03B8\u03CC\u03BD\u03B7)"
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 700]
    rotation: 0
    state: enabled
