    comment: "\u0395\u03CD\u03C1\u03BF\u03C2 \u03B2\u03C1\u03CC\u03C7\u03BF\u03C5\
      \ Costas (\u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC)"
