- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "\u0391\u03BD\u03AC\u03BA\u03C4\u03B7\u03C3\u03B7 \u03C7\u03C1\u03BF\u03BD\
      \u03B9\u03C3\u03BC\u03BF\u03CD \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03BF\u03C5\
      \ (Symbol Sync, TED = GARDNER) \u2014 \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9\
      \ 1 \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1/\u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\
      \u03BF, \u03A0\u03A1\u0399\u039D \u03B1\u03C0\u03CC \u03C4\u03B7 \u03BB\u03B5\
      \u03C0\u03C4\u03AE \u03B4\u03B9\u03CC\u03C1\u03B8\u03C9\u03C3\u03B7 \u03C6\u03AC\
      \u03C3\u03B7\u03C2 \u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\u03C2 (Costas).\
      \ \u039F \u03B1\u03BD\u03B9\u03C7\u03BD\u03B5\u03C5\u03C4\u03AE\u03C2 Gardner\
      \ \u03B5\u03C0\u03B9\u03BB\u03AD\u03C7\u03B8\u03B7\u03BA\u03B5 \u0395\u03A0\u0399\
      \u03A4\u0397\u0394\u0395\u03A3 \u03B1\u03BD\u03C4\u03AF \u03C4\u03BF\u03C5 Mueller\
      \ & Muller: \u03BF Gardner \u03B4\u03B5\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\
      \u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\
      \u03B5\u03B9\u03C2 \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03C9\u03BD, \u03AC\u03C1\
      \u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u0391\u039D\u0395\u039E\u0391\u03A1\u03A4\
      \u0397\u03A4\u039F\u03A3 \u03B1\u03C0\u03CC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\
      \u03C1\u03BF\u03C6\u03AE \u03C4\u03BF\u03C5 \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\
      \u03C3\u03BC\u03BF\u03CD \u2014 \u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\u03B5\
      \u03B9 \u03C4\u03BF\u03BD \u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC \u03B1\
      \u03BA\u03CC\u03BC\u03B7 \u03BA\u03B9 \u03CC\u03C3\u03BF \u03C5\u03C0\u03AC\u03C1\
      \u03C7\u03B5\u03B9 \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03BF \u03C3\u03C6\
      \u03AC\u03BB\u03BC\u03B1 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\
      \u03C2/\u03C6\u03AC\u03C3\u03B7\u03C2 \u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\
      \u03C2 (\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\
      \u03C5\u03BD\u03B8\u03AE\u03BA\u03B5\u03C2: \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\
      \u03C4\u03B7\u03C4\u03BF\u03B9 \u03BA\u03C1\u03CD\u03C3\u03C4\u03B1\u03BB\u03BB\
      \u03BF\u03B9 HackRF/RTL-SDR). \u039F M&M \u03B5\u03AF\u03BD\u03B1\u03B9 decision-directed\
      \ \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03C4\u03C5\u03B3\u03C7\u03AC\u03BD\u03B5\
      \u03B9 \u03CC\u03C4\u03B1\u03BD \u03BF \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\
      \u03BC\u03CC\u03C2 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\
      \u03C4\u03B1\u03B9. \u03A3\u03C4\u03BF GRC 3.10 \u03C0\u03C1\u03BF\u03C4\u03B9\
      \u03BC\u03AE\u03B8\u03B7\u03BA\u03B5 \u03C4\u03BF symbol_sync_cc \u03B1\u03BD\
      \u03C4\u03AF \u03C4\u03BF\u03C5 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\
      \u03C1\u03BF\u03C5 digital_clock_recovery_mm_cc, \u03C0\u03BF\u03C5 \u03B5\u03C0\
      \u03B9\u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03B8\u03B7\u03BA\u03B5 \u03B5\u03BC\
      \u03C0\u03B5\u03B9\u03C1\u03B9\u03BA\u03AC \u03CC\u03C4\u03B9 \u0394\u0395\u039D\
      \ \u03C3\u03C5\u03B3\u03BA\u03BB\u03AF\u03BD\u03B5\u03B9 \u03B1\u03BE\u03B9\u03CC\
      \u03C0\u03B9\u03C3\u03C4\u03B1 \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF\
      \ \u03C3\u03AE\u03BC\u03B1."
    constellation: QPSK_CONSTELLATION
    damping: '1.0'
    loop_bw: sync_bw
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '128'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_MMSE_8TAP
    sps: actual_sps
    ted_gain: '1.0'
    ted_type: digital.TED_GARDNER
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 476.0]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nPREAMBLE_SYMBOLS\
      \ = 64\nPREAMBLE_SEED = 42\nMESSAGE_TEXT = \"K510 PSK-QAM TEST\"\nWINDOW_BITS\
      \ = 5000\n\n\ndef _expected_frame_bits():\n    rng = np.random.RandomState(PREAMBLE_SEED)\n\
      \    preamble_syms = rng.randint(0, 4, size=PREAMBLE_SYMBOLS)\n    preamble_bits\
      \ = np.zeros((PREAMBLE_SYMBOLS, 2), dtype=np.int8)\n    preamble_bits[:, 0]\
      \ = (preamble_syms >> 1) & 1\n    preamble_bits[:, 1] = preamble_syms & 1\n\
      \    preamble_bits = preamble_bits.flatten()\n    payload_bits = np.unpackbits(\n\
      \        np.frombuffer(MESSAGE_TEXT.encode('ascii'), dtype=np.uint8)).astype(np.int8)\n\
      \    return np.concatenate([preamble_bits, payload_bits])\n\n\nEXPECTED_FRAME_BITS\
      \ = _expected_frame_bits()\nFRAME_LEN = len(EXPECTED_FRAME_BITS)\nPREAMBLE_PM1\
      \ = EXPECTED_FRAME_BITS[:2 * PREAMBLE_SYMBOLS].astype(np.float32) * 2 - 1\n\
      PREAMBLE_LEN = len(PREAMBLE_PM1)\nRECHECK_INTERVAL = FRAME_LEN * 8  # \u03C0\
      \u03B5\u03C1\u03AF\u03C0\u03BF\u03C5 \u03BA\u03AC\u03B8\u03B5 8 \u03B5\u03C0\
      \u03B1\u03BD\u03B1\u03BB\u03AE\u03C8\u03B5\u03B9\u03C2 \u03C0\u03BB\u03B1\u03B9\
      \u03C3\u03AF\u03BF\u03C5\n\n\nclass blk(gr.sync_block):\n    \"\"\"\u039C\u03B5\
      \u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 BER/SER: \u03B5\u03BD\u03C4\u03BF\u03C0\
      \u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF \u03B3\u03BD\u03C9\u03C3\u03C4\u03CC preamble\
      \ (64 \u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03B1,\n    fixed-seed=42 \u2014\
      \ \u0399\u0394\u0399\u039F\u03A3 \u03C3\u03C0\u03CC\u03C1\u03BF\u03C2 \u03BC\
      \u03B5 \u03C4\u03BF psk_tx.grc) \u03BC\u03AD\u03C3\u03C9 \u03C3\u03C5\u03C3\u03C7\
      \u03AD\u03C4\u03B9\u03C3\u03B7\u03C2 (correlation)\n    \u03C0\u03AC\u03BD\u03C9\
      \ \u03C3\u03C4\u03B7 \u03C1\u03BF\u03AE \u03B1\u03BD\u03B1\u03BA\u03C4\u03B7\
      \u03BC\u03AD\u03BD\u03C9\u03BD bits, \u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\
      \u03B5\u03B9 \u03C4\u03B7 \u03B8\u03AD\u03C3\u03B7 \u03BC\u03AD\u03C3\u03B1\
      \ \u03C3\u03C4\u03BF \u03B5\u03C0\u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03B1\
      \u03BD\u03CC\u03BC\u03B5\u03BD\u03BF\n    \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\
      \u03BF (preamble+\u03BC\u03AE\u03BD\u03C5\u03BC\u03B1 \xABK510 PSK-QAM TEST\xBB\
      , \u0399\u0394\u0399\u039F \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03BC\
      \u03B5 \u03C4\u03BF psk_tx.grc),\n    \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03AC\
      \ \u03C3\u03C5\u03B3\u03BA\u03C1\u03AF\u03BD\u03B5\u03B9 \u039A\u0391\u0398\u0395\
      \ \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF bit \u03BC\u03B5 \u03C4\u03BF \u03B1\
      \u03BD\u03B1\u03BC\u03B5\u03BD\u03CC\u03BC\u03B5\u03BD\u03BF, \u03B4\u03B9\u03B1\
      \u03C4\u03B7\u03C1\u03CE\u03BD\u03C4\u03B1\u03C2 \u03AD\u03BD\u03B1\n    \u03BA\
      \u03C5\u03BB\u03B9\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\
      \u03C5\u03C1\u03BF (sliding window) \u03C4\u03C9\u03BD \u03C4\u03B5\u03BB\u03B5\
      \u03C5\u03C4\u03B1\u03AF\u03C9\u03BD 5000 bits \u2014 BER = \u03C0\u03BF\u03C3\
      \u03BF\u03C3\u03C4\u03CC\n    \u03BB\u03B1\u03BD\u03B8\u03B1\u03C3\u03BC\u03AD\
      \u03BD\u03C9\u03BD bits, SER = \u03C0\u03BF\u03C3\u03BF\u03C3\u03C4\u03CC \u03C3\
      \u03C5\u03BC\u03B2\u03CC\u03BB\u03C9\u03BD (\u03B6\u03B5\u03CD\u03B3\u03B7 2\
      \ bits) \u03BC\u03B5 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\
      \u03BD \u03AD\u03BD\u03B1\n    \u03BB\u03AC\u03B8\u03BF\u03C2 bit. \u0388\u03BE\
      \u03BF\u03B4\u03BF\u03B9: \u03B4\u03CD\u03BF \u03C3\u03C5\u03BD\u03B5\u03C7\u03AE\
      \ \u03C1\u03B5\u03CD\u03BC\u03B1\u03C4\u03B1 float (BER, SER) \u2014 \u03B7\
      \ \u03C4\u03C1\u03AD\u03C7\u03BF\u03C5\u03C3\u03B1 \u03C4\u03B9\u03BC\u03AE\
      \ \u03C3\u03B5\n    \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1\
      \ \u03B5\u03B9\u03C3\u03CC\u03B4\u03BF\u03C5, \u03B3\u03B9\u03B1 \u03B1\u03C0\
      \u03B5\u03C5\u03B8\u03B5\u03AF\u03B1\u03C2 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\
      \u03B7 \u03C3\u03B5 QT GUI Number Sink.\n\n    \u03A4\u03C1\u03AD\u03C7\u03B5\
      \u03B9 \u03C3\u03C4\u03BF\u03BD \u03C1\u03C5\u03B8\u03BC\u03CC BIT (\u03AD\u03C9\
      \u03C2 ~100 kbps \u03B3\u03B9\u03B1 QPSK \u03C3\u03C4\u03B1 50 kbaud), \u03CC\
      \u03C7\u03B9 \u03C3\u03C4\u03BF\u03BD\n    \u03C0\u03BB\u03AE\u03C1\u03B7 \u03C1\
      \u03C5\u03B8\u03BC\u03CC \u03B4\u03B5\u03B9\u03B3\u03BC\u03B1\u03C4\u03BF\u03BB\
      \u03B7\u03C8\u03AF\u03B1\u03C2 RF \u2014 \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC\
      \ \u03AD\u03BD\u03B1 epy_block \u03B5\u03B4\u03CE \u03B4\u03B5\u03BD \u03BA\u03B9\
      \u03BD\u03B4\u03C5\u03BD\u03B5\u03CD\u03B5\u03B9\n    \u03B1\u03C0\u03CC \u03C4\
      \u03BF \u03C0\u03C1\u03CC\u03B2\u03BB\u03B7\u03BC\u03B1 \u03B1\u03BD\u03C4\u03B1\
      \u03B3\u03C9\u03BD\u03B9\u03C3\u03BC\u03BF\u03CD GIL/\u03C5\u03C0\u03BF\u03B4\
      \u03BF\u03C7\u03AD\u03B1 \u03C5\u03BB\u03B9\u03BA\u03BF\u03CD (lab2 ook_tx.grc)\xB7\
      \ \u03B7\n    \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE \u03BB\u03BF\
      \u03B3\u03B9\u03BA\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03BD\
      \u03C5\u03C3\u03BC\u03B1\u03C4\u03BF\u03C0\u03BF\u03B9\u03B7\u03BC\u03AD\u03BD\
      \u03B7 (numpy, \u03CC\u03C7\u03B9 \u03B2\u03C1\u03CC\u03C7\u03BF\u03C2 Python\
      \ \u03B1\u03BD\u03AC\n    bit) \u03CE\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03AD\u03C7\
      \u03B5\u03B9 \u03AC\u03BD\u03B5\u03C4\u03BF \u03C0\u03B5\u03C1\u03B9\u03B8\u03CE\
      \u03C1\u03B9\u03BF \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03BF\
      \u03CD \u03C7\u03C1\u03CC\u03BD\u03BF\u03C5 (~190x \u03B5\u03C0\u03B9\u03B2\u03B5\
      \u03B2\u03B1\u03B9\u03CE\u03B8\u03B7\u03BA\u03B5).\n    \"\"\"\n\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='\u039C\
      \u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 BER/SER',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.float32, np.float32],\n        )\n        self._synced\
      \ = False\n        self._history = np.zeros(0, dtype=np.int8)\n        self._frame_pos\
      \ = 0\n        self._bits_since_check = 0\n        self.resync_count = 0\n \
      \       self._bit_err_buf = np.zeros(WINDOW_BITS, dtype=np.uint8)\n        self._buf_ptr\
      \ = 0\n        self._buf_filled = 0\n        self._bit_err_sum = 0\n       \
      \ self._sym_err_buf = np.zeros(WINDOW_BITS // 2, dtype=np.uint8)\n        self._sym_ptr\
      \ = 0\n        self._sym_filled = 0\n        self._sym_err_sum = 0\n       \
      \ self._pending_bit = None\n        self.ber = 0.0\n        self.ser = 0.0\n\
      \n    def _update_bit_window(self, err_batch):\n        n = len(err_batch)\n\
      \        if n == 0:\n            return\n        buf = self._bit_err_buf\n \
      \       L = len(buf)\n        if n >= L:\n            buf[:] = err_batch[-L:]\n\
      \            self._bit_err_sum = int(buf.sum())\n            self._buf_ptr =\
      \ 0\n            self._buf_filled = L\n            return\n        ptr = self._buf_ptr\n\
      \        end = ptr + n\n        if end <= L:\n            old_sum = int(buf[ptr:end].sum())\n\
      \            buf[ptr:end] = err_batch\n        else:\n            first = L\
      \ - ptr\n            old_sum = int(buf[ptr:].sum()) + int(buf[:end - L].sum())\n\
      \            buf[ptr:] = err_batch[:first]\n            buf[:end - L] = err_batch[first:]\n\
      \        self._bit_err_sum += int(err_batch.sum()) - old_sum\n        self._buf_ptr\
      \ = end % L\n        self._buf_filled = min(self._buf_filled + n, L)\n\n   \
      \ def _update_sym_window(self, err_batch):\n        n = len(err_batch)\n   \
      \     if n == 0:\n            return\n        buf = self._sym_err_buf\n    \
      \    L = len(buf)\n        if n >= L:\n            buf[:] = err_batch[-L:]\n\
      \            self._sym_err_sum = int(buf.sum())\n            self._sym_ptr =\
      \ 0\n            self._sym_filled = L\n            return\n        ptr = self._sym_ptr\n\
      \        end = ptr + n\n        if end <= L:\n            old_sum = int(buf[ptr:end].sum())\n\
      \            buf[ptr:end] = err_batch\n        else:\n            first = L\
      \ - ptr\n            old_sum = int(buf[ptr:].sum()) + int(buf[:end - L].sum())\n\
      \            buf[ptr:] = err_batch[:first]\n            buf[:end - L] = err_batch[first:]\n\
      \        self._sym_err_sum += int(err_batch.sum()) - old_sum\n        self._sym_ptr\
      \ = end % L\n        self._sym_filled = min(self._sym_filled + n, L)\n\n   \
      \ def _record_bits(self, err_batch):\n        self._update_bit_window(err_batch)\n\
      \        if self._pending_bit is not None:\n            err_batch = np.concatenate([[self._pending_bit],\
      \ err_batch])\n            self._pending_bit = None\n        if len(err_batch)\
      \ % 2 == 1:\n            self._pending_bit = err_batch[-1]\n            err_batch\
      \ = err_batch[:-1]\n        if len(err_batch) > 0:\n            sym_err = err_batch.reshape(-1,\
      \ 2).any(axis=1).astype(np.uint8)\n            self._update_sym_window(sym_err)\n\
      \n    def _correlate_best(self, probe):\n        \"\"\"\u0395\u03C0\u03B9\u03C3\
      \u03C4\u03C1\u03AD\u03C6\u03B5\u03B9 (idx, \u03C4\u03B9\u03BC\u03AE \u03C3\u03C5\
      \u03C3\u03C7\u03AD\u03C4\u03B9\u03C3\u03B7\u03C2) \u03C4\u03B7\u03C2 \u03BA\u03B1\
      \u03BB\u03CD\u03C4\u03B5\u03C1\u03B7\u03C2 \u03B8\u03AD\u03C3\u03B7\u03C2 preamble\n\
