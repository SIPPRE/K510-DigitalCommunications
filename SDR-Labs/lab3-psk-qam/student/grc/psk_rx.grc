options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "QPSK RX (RTL-SDR): matched RRC + Symbol Sync + Costas Loop + BER/SER\
      \ \u03BC\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2. student (lab3-psk-qam)."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: psk_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: QPSK Receiver (RTL-SDR)
    window_size: (1300,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: actual_sps
  id: variable
  parameters:
    comment: "\u03A0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC \u03B4\u03B5\
      \u03AF\u03B3\u03BC\u03B1\u03C4\u03B1/\u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03BF\
      \ (\u03CC\u03C7\u03B9 \u03B1\u03C0\u03B1\u03C1\u03B1\u03AF\u03C4\u03B7\u03C4\
      \u03B1 \u03B1\u03BA\u03AD\u03C1\u03B1\u03B9\u03BF) \u2014 \u03C4\u03C1\u03BF\
      \u03C6\u03BF\u03B4\u03BF\u03C4\u03B5\u03AF \u03C4\u03BF matched filter \u03BA\
      \u03B1\u03B9 \u03C4\u03BF\u03BD Symbol Sync"
    value: quad_rate/symbol_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 228]
    rotation: 0
    state: enabled
- name: channel_decim
  id: variable
  parameters:
    comment: "\u0394\u03B5\u03BA\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C6\u03AF\
      \u03BB\u03C4\u03C1\u03BF\u03C5 \u03BA\u03B1\u03BD\u03B1\u03BB\u03B9\u03BF\u03CD\
      \ (\u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03B1\u03C3\u03C4\u03B9\u03BA\
      \u03AE \u03C0\u03B1\u03C1\u03AC\u03BC\u03B5\u03C4\u03C1\u03BF\u03C2 \u2014 \u03B1\
      \u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03BC\u03CC\u03BD\u03BF \u03BC\u03B5 Kill+Run,\
      \ \u03B2\u03BB. \u03C3\u03B7\u03BC\u03B5\u03AF\u03C9\u03C3\u03B7)"
    value: max(1, int(round(rtl_samp_rate/(symbol_rate*4))))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 228]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable
