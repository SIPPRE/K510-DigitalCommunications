- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ os\nimport csv\nimport datetime\n\nHEADER = ['timestamp', 'seat', 'tx_gain_db',\
      \ 'rf_gain_db', 'freq_mhz', 'scheme',\n          'symbol_rate', 'synced', 'ebn0_db',\
      \ 'ber', 'ser', 'bits']\n\n\nclass blk(gr.sync_block):\n    \"\"\"\u039A\u03B1\
      \u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03B5\u03BD\u03CC\u03C2 \u03C3\u03B7\
      \u03BC\u03B5\u03AF\u03BF\u03C5 \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7\u03C2\
      \ \u03C3\u03B5 CSV \u03BC\u03B5 \u03C4\u03BF \u03BA\u03BF\u03C5\u03BC\u03C0\u03AF\
      \ \xAB\u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C3\u03B7\u03BC\
      \u03B5\u03AF\u03BF\u03C5\xBB.\n\n    \u039C\u03B5 \u03C4\u03BF \u03C0\u03AC\u03C4\
      \u03B7\u03BC\u03B1 \u0394\u0395\u039D \u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\
      \u03B9 \u03B7 \u03C3\u03C4\u03B9\u03B3\u03BC\u03B9\u03B1\u03AF\u03B1 \u03C4\u03B9\
      \u03BC\u03AE: \u03BF logger \u03C0\u03B1\u03AF\u03C1\u03BD\u03B5\u03B9 \u03C4\
      \u03BF\u03BD \u039C\u0395\u03A3\u039F \u039F\u03A1\u039F\n    \u03C4\u03C9\u03BD\
      \ BER/SER/Eb/N0 \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03B5\u03C0\u03CC\u03BC\u03B5\
      \u03BD\u03B1 `avg_seconds` \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03CC\u03BB\u03B5\
      \u03C0\u03C4\u03B1 (\u03C0.\u03C7. 2 s =\n    80 000 bits \u03C3\u03C4\u03B1\
      \ 20 kbaud \u2192 \u03B4\u03B9\u03B1\u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03AE\
      \ \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 BER ~1e-5) \u03BA\u03B1\
      \u03B9 \u03BC\u03B5\u03C4\u03AC\n    \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C4\
      \u03B5\u03B9 \u03BC\u03AF\u03B1 \u03B3\u03C1\u03B1\u03BC\u03BC\u03AE \u03C3\u03C4\
      \u03BF ../results/psk_measurements.csv \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5\
      \ \u03C4\u03B7 \u03B8\u03AD\u03C3\u03B7\n    (seat), \u03C4\u03BF TX gain \u03C0\
      \u03BF\u03C5 \u03B1\u03BD\u03B1\u03BA\u03BF\u03AF\u03BD\u03C9\u03C3\u03B5 \u03BF\
      \ \u03B4\u03B9\u03B4\u03AC\u03C3\u03BA\u03C9\u03BD, \u03C4\u03BF RF gain \u03BA\
      \u03B1\u03B9 \u03C4\u03B7 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\
      .\n    synced = 1 \u03BC\u03CC\u03BD\u03BF \u03B1\u03BD \u03BF \u03BC\u03B5\u03C4\
      \u03C1\u03B7\u03C4\u03AE\u03C2 \u03AE\u03C4\u03B1\u03BD \u03BA\u03BB\u03B5\u03B9\
      \u03B4\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2 \u03C3\u03B5 \u039F\u039B\u039F \u03C4\
      \u03BF \u03B4\u03B9\u03AC\u03C3\u03C4\u03B7\u03BC\u03B1\xB7 \u03B1\u03BB\u03BB\
      \u03B9\u03CE\u03C2\n    \u03C4\u03B1 BER/SER \u03BC\u03AD\u03BD\u03BF\u03C5\u03BD\
      \ \u03BA\u03B5\u03BD\u03AC (\u03B7 \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7\
      \ \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\
      \u03C1\u03B7).\n    \u039F\u03B9 \u03B5\u03AF\u03C3\u03BF\u03B4\u03BF\u03B9\
      \ \u03C4\u03C1\u03AD\u03C7\u03BF\u03C5\u03BD \u03C3\u03C4\u03BF\u03BD \u03C1\
      \u03C5\u03B8\u03BC\u03CC bit (2 \xD7 symbol_rate \u03B3\u03B9\u03B1 QPSK).\n\
      \    \u03A4\u03C1\u03AD\u03BE\u03C4\u03B5 \u03C4\u03BF flowgraph \u03B1\u03C0\
      \u03CC \u03C4\u03BF\u03BD \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF student/grc/\
      \ (\u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03C1\
      \u03BF\u03BC\u03AE).\n    \"\"\"\n\n    def __init__(self, symbol_rate=20000.0,\
      \ rf_gain=0.0, freq=434.02,\n                 seat='?', tx_gain='?', avg_seconds=2.0):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='\u039A\
      \u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE CSV',\n            in_sig=[np.float32,\
      \ np.float32, np.float32, np.float32],\n            out_sig=[],\n        )\n\
      \        self.symbol_rate = symbol_rate\n        self.rf_gain = rf_gain\n  \
      \      self.freq = freq\n        self.seat = seat\n        self.tx_gain = tx_gain\n\
      \        self.avg_seconds = avg_seconds\n        self._request = False\n   \
      \     self._active = False\n        self._csv_path = os.path.join('..', 'results',\
      \ 'psk_measurements.csv')\n        self.message_port_register_in(pmt.intern('trigger'))\n\
      \        self.set_msg_handler(pmt.intern('trigger'), self._on_trigger)\n\n \
      \   def _on_trigger(self, msg):\n        self._request = True  # \u03B7 \u03BC\
      \u03AD\u03C4\u03C1\u03B7\u03C3\u03B7 \u03BE\u03B5\u03BA\u03B9\u03BD\u03AC \u03C3\
      \u03C4\u03BF \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF work()\n\n    def _start(self):\n\
      \        self._active = True\n        self._target = int(self.avg_seconds *\
      \ 2 * self.symbol_rate)\n        self._count = 0\n        self._sum_ber = 0.0\n\
      \        self._sum_ser = 0.0\n        self._sum_snr = 0.0\n        self._all_synced\
      \ = True\n        print('[\u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE\
      ] \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7 %.1f s ...' % self.avg_seconds,\
      \ flush=True)\n\n    def _open_csv(self):\n        os.makedirs(os.path.dirname(self._csv_path),\
      \ exist_ok=True)\n        if os.path.exists(self._csv_path):\n            with\
      \ open(self._csv_path, newline='') as f:\n                first = f.readline().strip()\n\
      \            if first != ','.join(HEADER):\n                # \u03A0\u03B1\u03BB\
      \u03B9\u03CC \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF \u03BC\u03B5 \u03AC\u03BB\u03BB\
      \u03B7 \u03BC\u03BF\u03C1\u03C6\u03AE \u03C3\u03C4\u03B7\u03BB\u03CE\u03BD:\
      \ \u03BA\u03C1\u03B1\u03C4\u03B9\u03AD\u03C4\u03B1\u03B9 \u03C9\u03C2 \u03B1\
      \u03BD\u03C4\u03AF\u03B3\u03C1\u03B1\u03C6\u03BF.\n                stamp = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')\n\
      \                os.rename(self._csv_path,\n                          self._csv_path.replace('.csv',\
      \ '_old_%s.csv' % stamp))\n        new_file = not os.path.exists(self._csv_path)\n\
      \        f = open(self._csv_path, 'a', newline='')\n        w = csv.writer(f)\n\
      \        if new_file:\n            w.writerow(HEADER)\n        return f, w\n\
      \n    def _finish(self):\n        self._active = False\n        n = max(self._count,\
      \ 1)\n        ber = self._sum_ber / n\n        ser = self._sum_ser / n\n   \
      \     snr = self._sum_snr / n\n        ok = self._all_synced\n        f, w =\
      \ self._open_csv()\n        with f:\n            w.writerow([\n            \
      \    datetime.datetime.now().isoformat(timespec='seconds'),\n              \
      \  str(self.seat), str(self.tx_gain),\n                '%g' % float(self.rf_gain),\
      \ '%.3f' % float(self.freq), 'QPSK',\n                '%.0f' % float(self.symbol_rate),\
      \ int(ok), '%.2f' % snr,\n                ('%.6f' % ber) if ok else '', ('%.6f'\
      \ % ser) if ok else '',\n                self._count,\n            ])\n    \
      \    if ok:\n            print('[\u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\
      \u03AE] seat=%s TX=%s RF=%g  Eb/N0=%.1f dB  BER=%.2e  SER=%.2e'\n          \
      \        % (self.seat, self.tx_gain, float(self.rf_gain), snr, ber, ser),\n\
      \                  flush=True)\n        else:\n            print('[\u039A\u03B1\
      \u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE] \u03A7\u03A9\u03A1\u0399\u03A3 \u03A3\
      \u03A5\u0393\u03A7\u03A1\u039F\u039D\u0399\u03A3\u039C\u039F \u2014 \u03B7 \u03B3\
      \u03C1\u03B1\u03BC\u03BC\u03AE \u03B3\u03C1\u03AC\u03C6\u03C4\u03B7\u03BA\u03B5\
      \ \u03BC\u03B5 \u03BA\u03B5\u03BD\u03CC BER '\n                  '(Eb/N0=%.1f\
      \ dB)' % snr, flush=True)\n\n    def work(self, input_items, output_items):\n\
      \        ber, ser, sync, snr = input_items\n        n = len(ber)\n        if\
      \ self._request and not self._active:\n            self._request = False\n \
      \           self._start()\n        if self._active and n:\n            k = min(n,\
      \ self._target - self._count)\n            self._sum_ber += float(ber[:k].sum())\n\
      \            self._sum_ser += float(ser[:k].sum())\n            self._sum_snr\
      \ += float(snr[:k].sum())\n            if np.any(sync[:k] < 0.5):\n        \
      \        self._all_synced = False\n            self._count += k\n          \
      \  if self._count >= self._target:\n                self._finish()\n       \
      \ return n\n"
