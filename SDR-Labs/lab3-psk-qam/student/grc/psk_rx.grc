      \u03B4\u03B9\u03B1 \u03C0\u03BF\u03C5 \u03C4\u03C1\u03BF\u03C6\u03BF\u03B4\u03BF\
      \u03C4\u03BF\u03CD\u03BD \u03C4\u03B1 QT GUI Number Sinks) \u03BA\u03B1\u03B9\
      \\n    \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C4\u03B5\u03B9 \u03BC\u03B9\u03B1\
      \ \u03B3\u03C1\u03B1\u03BC\u03BC\u03AE \u03C3\u03C4\u03BF student/results/psk_measurements.csv\
      \ (\u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AC \u03BC\u03B5\\n    \u03C4\u03B7\
      \ \u03B8\u03AD\u03C3\u03B7 \u03B1\u03C5\u03C4\u03BF\u03CD \u03C4\u03BF\u03C5\
      \ \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF\u03C5, \u03B4\u03B7\u03BB. student/grc/../results/...).\
      \ \u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03C4\u03BF\\\
      n    \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF (\u03BC\u03B5 \u03B3\u03C1\u03B1\u03BC\
