- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nPREAMBLE_SYMBOLS\
      \ = 64\nPREAMBLE_SEED = 42\nMESSAGE_TEXT = \"K510 PSK-QAM TEST\"\nWINDOW_BITS\
      \ = 5000\n\n\ndef _expected_frame_bits():\n    rng = np.random.RandomState(PREAMBLE_SEED)\n\
      \    preamble_syms = rng.randint(0, 4, size=PREAMBLE_SYMBOLS)\n    preamble_bits\
      \ = np.zeros((PREAMBLE_SYMBOLS, 2), dtype=np.int8)\n    preamble_bits[:, 0]\
      \ = (preamble_syms >> 1) & 1\n    preamble_bits[:, 1] = preamble_syms & 1\n\
      \    preamble_bits = preamble_bits.flatten()\n    payload_bits = np.unpackbits(\n\
      \        np.frombuffer(MESSAGE_TEXT.encode('ascii'), dtype=np.uint8)).astype(np.int8)\n\
      \    return np.concatenate([preamble_bits, payload_bits])\n\n\nEXPECTED_FRAME_BITS\
      \ = _expected_frame_bits()\nFRAME_LEN = len(EXPECTED_FRAME_BITS)\nPREAMBLE_PM1\
      \ = EXPECTED_FRAME_BITS[:2 * PREAMBLE_SYMBOLS].astype(np.float32) * 2 - 1\n\
      PREAMBLE_LEN = len(PREAMBLE_PM1)\nRECHECK_INTERVAL = FRAME_LEN * 8  # \u03C0\
      \u03B5\u03C1\u03AF\u03C0\u03BF\u03C5 \u03BA\u03AC\u03B8\u03B5 8 \u03B5\u03C0\
      \u03B1\u03BD\u03B1\u03BB\u03AE\u03C8\u03B5\u03B9\u03C2 \u03C0\u03BB\u03B1\u03B9\
      \u03C3\u03AF\u03BF\u03C5\n# \u03A0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03B1\
      \u03C5\u03C4\u03CC \u03C4\u03BF BER (\u03BC\u03B5 \u03B3\u03B5\u03BC\u03AC\u03C4\
      \u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF) \u03B8\u03B5\u03C9\u03C1\
      \u03BF\u03CD\u03BC\u03B5 \u03CC\u03C4\u03B9 \u03BF \u03B4\u03AD\u03BA\u03C4\u03B7\
      \u03C2 \u0395\u03A7\u0395\u0399 \u03A7\u0391\u03A3\u0395\u0399\n# \u03C4\u03BF\
      \ \u03C3\u03AE\u03BC\u03B1 (\u03C4\u03C5\u03C7\u03B1\u03AF\u03B1 bits \u03B4\
      \u03AF\u03BD\u03BF\u03C5\u03BD BER \u2248 0.5) \u03BA\u03B1\u03B9 \u03BE\u03B1\
      \u03BD\u03B1\u03C8\u03AC\u03C7\u03BD\u03BF\u03C5\u03BC\u03B5 \u03C4\u03BF preamble\
      \ \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE.\nUNLOCK_BER\
      \ = 0.25\n\n\nclass blk(gr.sync_block):\n    \"\"\"\u039C\u03B5\u03C4\u03C1\u03B7\
      \u03C4\u03AE\u03C2 BER/SER: \u03B5\u03BD\u03C4\u03BF\u03C0\u03AF\u03B6\u03B5\
      \u03B9 \u03C4\u03BF \u03B3\u03BD\u03C9\u03C3\u03C4\u03CC preamble (64 \u03C3\
      \u03CD\u03BC\u03B2\u03BF\u03BB\u03B1,\n    fixed-seed=42 \u2014 \u0399\u0394\
      \u0399\u039F\u03A3 \u03C3\u03C0\u03CC\u03C1\u03BF\u03C2 \u03BC\u03B5 \u03C4\u03BF\
      \u03BD \u03C0\u03BF\u03BC\u03C0\u03CC) \u03BC\u03AD\u03C3\u03C9 \u03C3\u03C5\
      \u03C3\u03C7\u03AD\u03C4\u03B9\u03C3\u03B7\u03C2 \u03C0\u03AC\u03BD\u03C9 \u03C3\
      \u03C4\u03B7 \u03C1\u03BF\u03AE\n    \u03B1\u03BD\u03B1\u03BA\u03C4\u03B7\u03BC\
      \u03AD\u03BD\u03C9\u03BD bits, \u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\u03B5\
      \u03B9 \u03C4\u03B7 \u03B8\u03AD\u03C3\u03B7 \u03BC\u03AD\u03C3\u03B1 \u03C3\
      \u03C4\u03BF \u03B5\u03C0\u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03B1\u03BD\
      \u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF\n\
      \    (preamble + \u03BC\u03AE\u03BD\u03C5\u03BC\u03B1 \xABK510 PSK-QAM TEST\xBB\
      ) \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03AC \u03C3\u03C5\u03B3\u03BA\u03C1\
      \u03AF\u03BD\u03B5\u03B9 \u039A\u0391\u0398\u0395 \u03B5\u03C0\u03CC\u03BC\u03B5\
      \u03BD\u03BF bit\n    \u03BC\u03B5 \u03C4\u03BF \u03B1\u03BD\u03B1\u03BC\u03B5\
      \u03BD\u03CC\u03BC\u03B5\u03BD\u03BF, \u03C3\u03B5 \u03BA\u03C5\u03BB\u03B9\u03CC\
      \u03BC\u03B5\u03BD\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF \u03C4\
      \u03C9\u03BD \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03C9\u03BD 5000\
      \ bits.\n    BER = \u03C0\u03BF\u03C3\u03BF\u03C3\u03C4\u03CC \u03BB\u03B1\u03BD\
      \u03B8\u03B1\u03C3\u03BC\u03AD\u03BD\u03C9\u03BD bits, SER = \u03C0\u03BF\u03C3\
      \u03BF\u03C3\u03C4\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03C9\u03BD (\u03B6\
      \u03B5\u03CD\u03B3\u03B7 bits) \u03BC\u03B5\n    \u03C4\u03BF\u03C5\u03BB\u03AC\
      \u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03AD\u03BD\u03B1 \u03BB\u03AC\u03B8\u03BF\
      \u03C2 bit.\n\n    \u0388\u03BE\u03BF\u03B4\u03BF\u03B9: BER, SER, \u03A3\u03A5\
      \u0393\u03A7\u03A1\u039F\u039D\u0399\u03A3\u039C\u039F\u03A3 (1 = \u03BA\u03BB\
      \u03B5\u03B9\u03B4\u03C9\u03BC\u03AD\u03BD\u03BF \u03C3\u03C4\u03BF \u03C0\u03BB\
      \u03B1\u03AF\u03C3\u03B9\u03BF, 0 = \u03CC\u03C7\u03B9).\n    \u038C\u03C3\u03BF\
      \ \u0394\u0395\u039D \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03C3\u03C5\
      \u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC\u03C2, \u03C4\u03BF BER/SER\
      \ \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9 0.5/0.75 (\u03B7 \u03C4\u03B9\u03BC\
      \u03AE \u03C4\u03C9\u03BD\n    \u03C4\u03C5\u03C7\u03B1\u03AF\u03C9\u03BD bits)\
      \ \u2014 \u03A0\u039F\u03A4\u0395 \u03C8\u03B5\u03CD\u03C4\u03B9\u03BA\u03BF\
      \ 0. \u0391\u03BD \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF \u03BA\u03BB\u03B5\u03AF\
      \u03B4\u03C9\u03BC\u03B1 \u03C4\u03BF BER \u03C4\u03BF\u03C5 \u03B3\u03B5\u03BC\
      \u03AC\u03C4\u03BF\u03C5\n    \u03C0\u03B1\u03C1\u03B1\u03B8\u03CD\u03C1\u03BF\
      \u03C5 \u03BE\u03B5\u03C0\u03B5\u03C1\u03AC\u03C3\u03B5\u03B9 \u03C4\u03BF 0.25,\
      \ \u03BF \u03BC\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 \xAB\u03BE\u03B5\u03BA\
      \u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\u03B5\u03B9\xBB, \u03BC\u03B7\u03B4\u03B5\
      \u03BD\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\
      \u03C1\u03BF\n    \u03BA\u03B1\u03B9 \u03BE\u03B1\u03BD\u03B1\u03C8\u03AC\u03C7\
      \u03BD\u03B5\u03B9 \u03C4\u03BF preamble (\u03C0.\u03C7. \u03CC\u03C4\u03B1\u03BD\
      \ \u03C7\u03AC\u03B8\u03B7\u03BA\u03B5 \u03C4\u03BF \u03C3\u03AE\u03BC\u03B1\
      \ \u03AE \u03B3\u03BB\u03AF\u03C3\u03C4\u03C1\u03B7\u03C3\u03B5 \u03BF \u03B4\
      \u03AD\u03BA\u03C4\u03B7\u03C2).\n    \"\"\"\n\n    def __init__(self):\n  \
      \      gr.sync_block.__init__(\n            self,\n            name='\u039C\u03B5\
      \u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 BER/SER',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.float32, np.float32, np.float32],\n        )\n    \
      \    self.resync_count = 0\n        self.unlock_count = 0\n        self._history\
      \ = np.zeros(0, dtype=np.int8)\n        self._reset_lock()\n\n    # ------------------------------------------------------------------\n\
      \    def _reset_lock(self):\n        self._synced = False\n        self._frame_pos\
      \ = 0\n        self._bits_since_check = 0\n        self._bit_err_buf = np.zeros(WINDOW_BITS,\
      \ dtype=np.uint8)\n        self._buf_ptr = 0\n        self._buf_filled = 0\n\
      \        self._bit_err_sum = 0\n        self._sym_err_buf = np.zeros(WINDOW_BITS\
      \ // 2, dtype=np.uint8)\n        self._sym_ptr = 0\n        self._sym_filled\
      \ = 0\n        self._sym_err_sum = 0\n        self._pending_bit = None\n   \
      \     self.ber = 0.5\n        self.ser = 0.75\n\n    @staticmethod\n    def\
      \ _push(buf, ptr, filled, total, err_batch):\n        \"\"\"\u039A\u03C5\u03BB\
      \u03B9\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\
      \u03BF \u03C3\u03C6\u03B1\u03BB\u03BC\u03AC\u03C4\u03C9\u03BD (\u03BA\u03C5\u03BA\
      \u03BB\u03B9\u03BA\u03CC\u03C2 buffer). \u0395\u03C0\u03B9\u03C3\u03C4\u03C1\
      \u03AD\u03C6\u03B5\u03B9\n        (ptr, filled, sum) \u03BC\u03B5\u03C4\u03AC\
      \ \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03C4\
      \u03BF\u03C5 err_batch.\"\"\"\n        n = len(err_batch)\n        L = len(buf)\n\
      \        if n == 0:\n            return ptr, filled, total\n        if n >=\
      \ L:\n            buf[:] = err_batch[-L:]\n            return 0, L, int(buf.sum())\n\
      \        end = ptr + n\n        if end <= L:\n            old = int(buf[ptr:end].sum())\n\
      \            buf[ptr:end] = err_batch\n        else:\n            first = L\
      \ - ptr\n            old = int(buf[ptr:].sum()) + int(buf[:end - L].sum())\n\
      \            buf[ptr:] = err_batch[:first]\n            buf[:end - L] = err_batch[first:]\n\
      \        return end % L, min(filled + n, L), total + int(err_batch.sum()) -\
      \ old\n\n    def _record_bits(self, err_batch):\n        self._buf_ptr, self._buf_filled,\
      \ self._bit_err_sum = self._push(\n            self._bit_err_buf, self._buf_ptr,\
      \ self._buf_filled,\n            self._bit_err_sum, err_batch)\n        if self._pending_bit\
      \ is not None:\n            err_batch = np.concatenate([[self._pending_bit],\
      \ err_batch])\n            self._pending_bit = None\n        if len(err_batch)\
      \ % 2 == 1:\n            self._pending_bit = err_batch[-1]\n            err_batch\
      \ = err_batch[:-1]\n        if len(err_batch) > 0:\n            sym_err = err_batch.reshape(-1,\
      \ 2).any(axis=1).astype(np.uint8)\n            self._sym_ptr, self._sym_filled,\
      \ self._sym_err_sum = self._push(\n                self._sym_err_buf, self._sym_ptr,\
      \ self._sym_filled,\n                self._sym_err_sum, sym_err)\n\n    def\
      \ _correlate_best(self, probe):\n        \"\"\"(idx, \u03C4\u03B9\u03BC\u03AE\
      ) \u03C4\u03B7\u03C2 \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7\u03C2\
      \ \u03B8\u03AD\u03C3\u03B7\u03C2 preamble \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\
      \u03BF probe, \u03AE\n        (None, None). \u0391\u03C0\u03B1\u03B9\u03C4\u03B5\
      \u03AF\u03C4\u03B1\u03B9 \u03C3\u03C7\u03B5\u03B4\u03CC\u03BD \u03A4\u0395\u039B\
      \u0395\u0399\u039F \u03C4\u03B1\u03AF\u03C1\u03B9\u03B1\u03C3\u03BC\u03B1 (\u2264\
      2 \u03BB\u03AC\u03B8\u03B7 \u03C3\u03C4\u03B1 128\n        bits): \u03BC\u03B5\
      \ \u03C7\u03B1\u03BB\u03B1\u03C1\u03CC \u03BA\u03B1\u03C4\u03CE\u03C6\u03BB\u03B9\
      , \u03B7 \xAB\u03B8\u03BF\u03C1\u03C5\u03B2\u03CE\u03B4\u03B7\u03C2\xBB \u03C1\
      \u03BF\u03AE bits \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03C3\u03CD\u03B3\u03BA\
      \u03BB\u03B9\u03C3\u03B7 \u03C4\u03C9\u03BD\n        \u03B2\u03C1\u03CC\u03C7\
      \u03C9\u03BD \u03AD\u03B4\u03B9\u03BD\u03B5 \u03BA\u03B1\u03C4\u03AC \u03BA\u03B1\
      \u03B9\u03C1\u03BF\u03CD\u03C2 \u03C8\u03B5\u03C5\u03B4\u03B5\u03AF\u03C2 \u03C3\
      \u03C5\u03C3\u03C7\u03B5\u03C4\u03AF\u03C3\u03B5\u03B9\u03C2 \u03C3\u03B5 \u03BB\
      \u03AC\u03B8\u03BF\u03C2 \u03B8\u03AD\u03C3\u03B7.\"\"\"\n        if len(probe)\
      \ < PREAMBLE_LEN:\n            return None, None\n        pm1 = probe.astype(np.float32)\
      \ * 2 - 1\n        corr = np.correlate(pm1, PREAMBLE_PM1, mode='valid')\n  \
      \      idx = int(np.argmax(corr))\n        if corr[idx] >= PREAMBLE_LEN - 4:\n\
      \            return idx, int(corr[idx])\n        return None, None\n\n    #\
      \ ------------------------------------------------------------------\n    def\
      \ work(self, input_items, output_items):\n        x = input_items[0].astype(np.int8)\n\
      \        n = len(x)\n        # \u03A4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\
      \u03C4\u03BF\u03BD \u03BC\u03AF\u03B1 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2 \u03C0\
      \u03B5\u03C1\u03AF\u03BF\u03B4\u03BF\u03C2 \u03C0\u03BB\u03B1\u03B9\u03C3\u03AF\
      \u03BF\u03C5 + \u03C0\u03B5\u03C1\u03B9\u03B8\u03CE\u03C1\u03B9\u03BF, \u03CE\
      \u03C3\u03C4\u03B5 \u03C4\u03BF\n        # \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\
      \u03BA\u03CC \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03AD\u03C7\u03B5\u03B9 \u03C0\
      \u03AC\u03BD\u03C4\u03B1 \u03AD\u03BD\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\
      \u03C1\u03BF preamble.\n        HIST_LEN = FRAME_LEN + 64\n\n        if not\
      \ self._synced:\n            probe = np.concatenate([self._history, x])\n  \
      \          idx, _ = self._correlate_best(probe)\n            if idx is not None:\n\
      \                self._synced = True\n                base = len(probe) - n\
      \  # \u03B8\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5 x \u03BC\u03AD\u03C3\u03B1\
      \ \u03C3\u03C4\u03BF probe\n                # \u03BC\u03CC\u03BD\u03BF \u03C4\
      \u03B1 bits \u039C\u0395\u03A4\u0391 \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE\
      \ \u03C4\u03BF\u03C5 preamble \u03BC\u03B5\u03C4\u03C1\u03BF\u03CD\u03BD\n \
      \               start = max(0, idx - base)\n                positions = (np.arange(start,\
      \ n, dtype=np.int64) + base - idx) % FRAME_LEN\n                err_batch =\
      \ (x[start:] != EXPECTED_FRAME_BITS[positions]).astype(np.uint8)\n         \
      \       self._record_bits(err_batch)\n                self._frame_pos = (len(probe)\
      \ - idx) % FRAME_LEN\n                self._bits_since_check = 0\n         \
      \   self._history = probe[-HIST_LEN:]\n        else:\n            self._history\
      \ = np.concatenate([self._history, x])[-HIST_LEN:]\n            idxs = (self._frame_pos\
      \ + np.arange(n)) % FRAME_LEN\n            err_batch = (x != EXPECTED_FRAME_BITS[idxs]).astype(np.uint8)\n\
      \            self._record_bits(err_batch)\n            self._frame_pos = (self._frame_pos\
      \ + n) % FRAME_LEN\n            self._bits_since_check += n\n\n            #\
      \ \u03A0\u03B5\u03C1\u03B9\u03BF\u03B4\u03B9\u03BA\u03AE \u03B5\u03C0\u03B1\u03BB\
      \u03AE\u03B8\u03B5\u03C5\u03C3\u03B7 \u03C3\u03C4\u03BF\u03AF\u03C7\u03B9\u03C3\
      \u03B7\u03C2 (\u03BF\u03BB\u03AF\u03C3\u03B8\u03B7\u03C3\u03B7 \u03C1\u03BF\u03BB\
      \u03BF\u03B3\u03B9\u03BF\u03CD TX/RX).\n            if self._bits_since_check\
      \ >= RECHECK_INTERVAL:\n                self._bits_since_check = 0\n       \
      \         idx, _ = self._correlate_best(self._history)\n                if idx\
      \ is not None:\n                    corrected = int((len(self._history) - idx)\
      \ % FRAME_LEN)\n                    if corrected != self._frame_pos:\n     \
      \                   self.resync_count += 1\n                    self._frame_pos\
      \ = corrected\n\n            # \u03A7\u03B1\u03BC\u03AD\u03BD\u03BF \u03C3\u03AE\
      \u03BC\u03B1 / \u03BB\u03AC\u03B8\u03BF\u03C2 \u03C3\u03C4\u03BF\u03AF\u03C7\
      \u03B9\u03C3\u03B7: \u03BE\u03B5\u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1\
      \ \u03BA\u03B1\u03B9 \u03BD\u03AD\u03B1 \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\
      \u03B7\u03C3\u03B7.\n            if (self._buf_filled >= WINDOW_BITS and\n \
      \                   self._bit_err_sum > UNLOCK_BER * WINDOW_BITS):\n       \
      \         self.unlock_count += 1\n                self._reset_lock()\n\n   \
      \     if self._synced:\n            if self._buf_filled > 0:\n             \
      \   self.ber = self._bit_err_sum / float(self._buf_filled)\n            if self._sym_filled\
      \ > 0:\n                self.ser = self._sym_err_sum / float(self._sym_filled)\n\
      \n        output_items[0][:] = self.ber\n        output_items[1][:] = self.ser\n\
      \        output_items[2][:] = 1.0 if self._synced else 0.0\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
