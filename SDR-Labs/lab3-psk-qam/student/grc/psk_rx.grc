- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "\u0391\u03BD\u03AC\u03BA\u03C4\u03B7\u03C3\u03B7 \u03C7\u03C1\u03BF\u03BD\
      \u03B9\u03C3\u03BC\u03BF\u03CD \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03BF\u03C5\
      \ (Symbol Sync, TED = GARDNER) \u2014 \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9\
      \ 1 \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1/\u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\
      \u03BF, \u03A0\u03A1\u0399\u039D \u03B1\u03C0\u03CC \u03C4\u03B7 \u03BB\u03B5\
      \u03C0\u03C4\u03AE \u03B4\u03B9\u03CC\u03C1\u03B8\u03C9\u03C3\u03B7 \u03C6\u03AC\
      \u03C3\u03B7\u03C2 \u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\u03C2 (Costas).\
      \ \u039F \u03B1\u03BD\u03B9\u03C7\u03BD\u03B5\u03C5\u03C4\u03AE\u03C2 Gardner\
      \ \u03B5\u03C0\u03B9\u03BB\u03AD\u03C7\u03B8\u03B7\u03BA\u03B5 \u0395\u03A0\u0399\
      \u03A4\u0397\u0394\u0395\u03A3 \u03B1\u03BD\u03C4\u03AF \u03C4\u03BF\u03C5 Mueller\
      \ & Muller: \u03BF Gardner \u03B4\u03B5\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\
      \u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\
      \u03B5\u03B9\u03C2 \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03C9\u03BD, \u03AC\u03C1\
      \u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u0391\u039D\u0395\u039E\u0391\u03A1\u03A4\
      \u0397\u03A4\u039F\u03A3 \u03B1\u03C0\u03CC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\
      \u03C1\u03BF\u03C6\u03AE \u03C4\u03BF\u03C5 \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\
      \u03C3\u03BC\u03BF\u03CD \u2014 \u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\u03B5\
      \u03B9 \u03C4\u03BF\u03BD \u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC \u03B1\
      \u03BA\u03CC\u03BC\u03B7 \u03BA\u03B9 \u03CC\u03C3\u03BF \u03C5\u03C0\u03AC\u03C1\
      \u03C7\u03B5\u03B9 \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03BF \u03C3\u03C6\
      \u03AC\u03BB\u03BC\u03B1 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\
      \u03C2/\u03C6\u03AC\u03C3\u03B7\u03C2 \u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\
      \u03C2 (\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\
      \u03C5\u03BD\u03B8\u03AE\u03BA\u03B5\u03C2: \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\
      \u03C4\u03B7\u03C4\u03BF\u03B9 \u03BA\u03C1\u03CD\u03C3\u03C4\u03B1\u03BB\u03BB\
      \u03BF\u03B9 HackRF/RTL-SDR). \u039F M&M \u03B5\u03AF\u03BD\u03B1\u03B9 decision-directed\
      \ \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03C4\u03C5\u03B3\u03C7\u03AC\u03BD\u03B5\
      \u03B9 \u03CC\u03C4\u03B1\u03BD \u03BF \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\
      \u03BC\u03CC\u03C2 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\
      \u03C4\u03B1\u03B9. \u03A3\u03C4\u03BF GRC 3.10 \u03C0\u03C1\u03BF\u03C4\u03B9\
      \u03BC\u03AE\u03B8\u03B7\u03BA\u03B5 \u03C4\u03BF symbol_sync_cc \u03B1\u03BD\
      \u03C4\u03AF \u03C4\u03BF\u03C5 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\
      \u03C1\u03BF\u03C5 digital_clock_recovery_mm_cc, \u03C0\u03BF\u03C5 \u03B5\u03C0\
      \u03B9\u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03B8\u03B7\u03BA\u03B5 \u03B5\u03BC\
      \u03C0\u03B5\u03B9\u03C1\u03B9\u03BA\u03AC \u03CC\u03C4\u03B9 \u0394\u0395\u039D\
      \ \u03C3\u03C5\u03B3\u03BA\u03BB\u03AF\u03BD\u03B5\u03B9 \u03B1\u03BE\u03B9\u03CC\
      \u03C0\u03B9\u03C3\u03C4\u03B1 \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF\
      \ \u03C3\u03AE\u03BC\u03B1."
    constellation: QPSK_CONSTELLATION
    damping: '1.0'
    loop_bw: sync_bw
    max_dev: '1.5'
    maxoutbuf: '0'
