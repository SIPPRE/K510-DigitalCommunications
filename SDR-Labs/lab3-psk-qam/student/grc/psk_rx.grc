      \ 1)], '\u039C\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 BER/SER: \u03B5\u03BD\
      \u03C4\u03BF\u03C0\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF \u03B3\u03BD\u03C9\u03C3\
      \u03C4\u03CC preamble (64 \u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03B1,\\n   \
      \ fixed-seed=42 \u2014 \u0399\u0394\u0399\u039F\u03A3 \u03C3\u03C0\u03CC\u03C1\
      \u03BF\u03C2 \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C0\u03BF\u03BC\u03C0\u03CC\
      ) \u03BC\u03AD\u03C3\u03C9 \u03C3\u03C5\u03C3\u03C7\u03AD\u03C4\u03B9\u03C3\u03B7\
      \u03C2 \u03C0\u03AC\u03BD\u03C9 \u03C3\u03C4\u03B7 \u03C1\u03BF\u03AE\\n   \
      \ \u03B1\u03BD\u03B1\u03BA\u03C4\u03B7\u03BC\u03AD\u03BD\u03C9\u03BD bits, \u03BA\
      \u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7 \u03B8\u03AD\u03C3\
      \u03B7 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03BF \u03B5\u03C0\u03B1\u03BD\u03B1\
      \u03BB\u03B1\u03BC\u03B2\u03B1\u03BD\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03BB\
      \u03B1\u03AF\u03C3\u03B9\u03BF\\n    (preamble + \u03BC\u03AE\u03BD\u03C5\u03BC\
      \u03B1 \xABK510 PSK-QAM TEST\xBB) \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03AC\
      \ \u03C3\u03C5\u03B3\u03BA\u03C1\u03AF\u03BD\u03B5\u03B9 \u039A\u0391\u0398\u0395\
      \ \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF bit\\n    \u03BC\u03B5 \u03C4\u03BF\
      \ \u03B1\u03BD\u03B1\u03BC\u03B5\u03BD\u03CC\u03BC\u03B5\u03BD\u03BF, \u03C3\
      \u03B5 \u03BA\u03C5\u03BB\u03B9\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03B1\u03C1\
      \u03AC\u03B8\u03C5\u03C1\u03BF \u03C4\u03C9\u03BD \u03C4\u03B5\u03BB\u03B5\u03C5\
      \u03C4\u03B1\u03AF\u03C9\u03BD 5000 bits.\\n    BER = \u03C0\u03BF\u03C3\u03BF\
      \u03C3\u03C4\u03CC \u03BB\u03B1\u03BD\u03B8\u03B1\u03C3\u03BC\u03AD\u03BD\u03C9\
      \u03BD bits, SER = \u03C0\u03BF\u03C3\u03BF\u03C3\u03C4\u03CC \u03C3\u03C5\u03BC\
      \u03B2\u03CC\u03BB\u03C9\u03BD (\u03B6\u03B5\u03CD\u03B3\u03B7 bits) \u03BC\u03B5\
      \\n    \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03AD\
      \u03BD\u03B1 \u03BB\u03AC\u03B8\u03BF\u03C2 bit.\\n\\n    \u0388\u03BE\u03BF\
      \u03B4\u03BF\u03B9: BER, SER, \u03A3\u03A5\u0393\u03A7\u03A1\u039F\u039D\u0399\
      \u03A3\u039C\u039F\u03A3 (1 = \u03BA\u03BB\u03B5\u03B9\u03B4\u03C9\u03BC\u03AD\
      \u03BD\u03BF \u03C3\u03C4\u03BF \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF,\
      \ 0 = \u03CC\u03C7\u03B9).\\n    \u038C\u03C3\u03BF \u0394\u0395\u039D \u03C5\
      \u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03C3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\
      \u03B9\u03C3\u03BC\u03CC\u03C2, \u03C4\u03BF BER/SER \u03B4\u03B5\u03AF\u03C7\
      \u03BD\u03B5\u03B9 0.5/0.75 (\u03B7 \u03C4\u03B9\u03BC\u03AE \u03C4\u03C9\u03BD\
      \\n    \u03C4\u03C5\u03C7\u03B1\u03AF\u03C9\u03BD bits) \u2014 \u03A0\u039F\u03A4\
      \u0395 \u03C8\u03B5\u03CD\u03C4\u03B9\u03BA\u03BF 0. \u0391\u03BD \u03BC\u03B5\
      \u03C4\u03AC \u03C4\u03BF \u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1 \u03C4\
      \u03BF BER \u03C4\u03BF\u03C5 \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF\u03C5\\n\
      \    \u03C0\u03B1\u03C1\u03B1\u03B8\u03CD\u03C1\u03BF\u03C5 \u03BE\u03B5\u03C0\
      \u03B5\u03C1\u03AC\u03C3\u03B5\u03B9 \u03C4\u03BF 0.25, \u03BF \u03BC\u03B5\u03C4\
      \u03C1\u03B7\u03C4\u03AE\u03C2 \xAB\u03BE\u03B5\u03BA\u03BB\u03B5\u03B9\u03B4\
      \u03CE\u03BD\u03B5\u03B9\xBB, \u03BC\u03B7\u03B4\u03B5\u03BD\u03AF\u03B6\u03B5\
      \u03B9 \u03C4\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF\\n    \u03BA\
      \u03B1\u03B9 \u03BE\u03B1\u03BD\u03B1\u03C8\u03AC\u03C7\u03BD\u03B5\u03B9 \u03C4\
      \u03BF preamble (\u03C0.\u03C7. \u03CC\u03C4\u03B1\u03BD \u03C7\u03AC\u03B8\u03B7\
      \u03BA\u03B5 \u03C4\u03BF \u03C3\u03AE\u03BC\u03B1 \u03AE \u03B3\u03BB\u03AF\
      \u03C3\u03C4\u03C1\u03B7\u03C3\u03B5 \u03BF \u03B4\u03AD\u03BA\u03C4\u03B7\u03C2\
      ).\\n    ', [])"
