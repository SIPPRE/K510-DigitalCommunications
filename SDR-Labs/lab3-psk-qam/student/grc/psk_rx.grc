      \u03BA\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C3\u03C4\u03BF\u03BD \u03C1\
      \u03C5\u03B8\u03BC\u03CC quad_rate. \u03A4\u03BF cutoff \u03AD\u03C7\u03B5\u03B9\
      \ +10 kHz \u03C0\u03B5\u03C1\u03B9\u03B8\u03CE\u03C1\u03B9\u03BF \u03CE\u03C3\
      \u03C4\u03B5 \u03C4\u03BF \u03C3\u03AE\u03BC\u03B1 \u03BD\u03B1 \u03C0\u03B5\
