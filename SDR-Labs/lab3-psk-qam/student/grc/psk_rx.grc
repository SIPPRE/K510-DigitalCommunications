- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: "import numpy as np\nfrom math import pi\nfrom cmath import exp\nfrom\
      \ gnuradio import digital\nfrom gnuradio.digital.utils import gray_code\n\n\
      # --- \u03A0\u03A1\u0395\u03A0\u0395\u0399 \u03BD\u03B1 \u03C4\u03B1\u03B9\u03C1\
      \u03B9\u03AC\u03B6\u03BF\u03C5\u03BD \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2\
      \ \u03BC\u03B5 \u03C4\u03B1 \u03AF\u03B4\u03B9\u03B1 \u03C3\u03CD\u03BC\u03B2\
      \u03BF\u03BB\u03B1 \u03C3\u03C4\u03BF psk_tx.grc ---\nQPSK_POINTS = [complex(exp(2\
      \ * pi * (0 + 1j) * i / 4)) for i in range(4)]\nQPSK_GRAY_MAP = list(gray_code.gray_code(4))\n\
      INV_GRAY_MAP = [0] * 4\nfor _i, _g in enumerate(QPSK_GRAY_MAP):\n    INV_GRAY_MAP[_g]\
      \ = _i\n\n# \u0391\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF\
      \ \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD (\u03AF\u03B4\
      \u03B9\u03B1 \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1/\u03B5\u03C5\u03C1\u03B5\u03C4\
      \u03AE\u03C1\u03B9\u03BF \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C0\u03BF\u03BC\u03C0\
      \u03CC \u2014 \u03B1\u03C0\u03BB\u03AE/\u03BC\u03B7\n# \u03B1\u03BD\u03B1\u03B4\
      \u03B9\u03B1\u03C4\u03B1\u03B3\u03BC\u03AD\u03BD\u03B7 \u03B1\u03BD\u03C4\u03B9\
      \u03C3\u03C4\u03BF\u03AF\u03C7\u03B9\u03C3\u03B7, \u03AF\u03B4\u03B9\u03B1 \u03BB\
      \u03BF\u03B3\u03B9\u03BA\u03AE \u03BC\u03B5 \u03C4\u03BF QPSK_POINTS/GRAY_MAP\
      \ \u03B5\u03B4\u03CE)\xB7\n# \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\
      \u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9 \u039A\u0391\u0399 \u03B1\u03C0\u03CC\
      \ \u03C4\u03BF\u03BD Symbol Sync (decision-directed TED) \u039A\u0391\u0399\
      \ \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD\n# Constellation Decoder, \u03CE\u03C3\
      \u03C4\u03B5 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B4\u03CD\u03BF \u03BD\u03B1\
      \ \xAB\u03B2\u03BB\u03AD\u03C0\u03BF\u03C5\u03BD\xBB \u03B1\u03BA\u03C1\u03B9\
      \u03B2\u03CE\u03C2 \u03C4\u03B1 \u03AF\u03B4\u03B9\u03B1 \u03C3\u03B7\u03BC\u03B5\
      \u03AF\u03B1.\nQPSK_CONSTELLATION = digital.constellation_calcdist(\n    QPSK_POINTS,\
      \ list(range(4)), 4, 1).base()\n\n# \u03A3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AE\
      \ \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE +45\xB0 \u03BC\
      \u03B5\u03C4\u03AC \u03C4\u03BF\u03BD \u03B2\u03C1\u03CC\u03C7\u03BF Costas:\
      \ \u03BF 4\u03B7\u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2 Costas Loop \u03C4\u03BF\
      \u03C5\n# GNU Radio \u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\u03B5\u03B9 \u03C3\
      \u03B5 \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \xAB\u03B4\u03B9\u03B1\u03B3\
      \u03CE\u03BD\u03B9\u03BF\u03C5\xBB QPSK (\u03C3\u03B7\u03BC\u03B5\u03AF\u03B1\
      \ \u03C3\u03C4\u03B9\u03C2 \xB145\xB0/\xB1135\xB0),\n# \u039F\u03A7\u0399 \u03C3\
      \u03C4\u03B7\u03BD \u03B1\u03C0\u03CC\u03BB\u03C5\u03C4\u03B7 \u03B5\u03C5\u03B8\
      \u03C5\u03B3\u03C1\u03AC\u03BC\u03BC\u03B9\u03C3\u03B7 \u03B1\u03BE\u03CC\u03BD\
      \u03C9\u03BD (0\xB0/90\xB0/180\xB0/270\xB0) \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B7\
      \u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03C4\u03BF\n# QPSK_POINTS\
      \ \u03B5\u03B4\u03CE \u2014 \u03B5\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03B9\
      \u03CE\u03B8\u03B7\u03BA\u03B5 \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03B9\u03BA\
      \u03AC (\u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03CC\u03C2 \u03B2\u03C1\u03CC\u03C7\
      \u03BF\u03C2, \u03BC\u03B7\u03B4\u03B5\u03BD\u03B9\u03BA\u03CC BER\n# \u03BC\
      \u03CC\u03BD\u03BF \u03BC\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03BF\
      \u03C6\u03AE \xB145\xB0/\xB1135\xB0). \u0397 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\
      \u03C1\u03BF\u03C6\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03A3\u03A4\u0391\u0398\
      \u0395\u03A1\u0397 (\u03BA\u03B1\u03B8\u03B1\u03C1\u03AC \u03C3\u03CD\u03BC\u03B2\
      \u03B1\u03C3\u03B7),\n# \u03CC\u03C7\u03B9 \u03BC\u03AD\u03C1\u03BF\u03C2 \u03BF\
      \u03C0\u03BF\u03B9\u03B1\u03C3\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03B1\u03C3\
      \u03AC\u03C6\u03B5\u03B9\u03B1\u03C2 \u03C6\u03AC\u03C3\u03B7\u03C2\xB7 \u03B7\
      \ \u03B1\u03C3\u03AC\u03C6\u03B5\u03B9\u03B1 \u039D \u03C6\u03AC\u03C3\u03B5\
      \u03C9\u03BD (\u03B5\u03B4\u03CE 4-\u03C0\u03BB\u03AE) \u03C0\u03BF\u03C5\n\
      # \u03A0\u0391\u03A1\u0391\u039C\u0395\u039D\u0395\u0399 \u03BC\u03B5\u03C4\u03AC\
      \ \u03C4\u03BF \u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1 Costas \u03B5\
      \u03C0\u03B9\u03BB\u03CD\u03B5\u03C4\u03B1\u03B9 \u03BE\u03B5\u03C7\u03C9\u03C1\
      \u03B9\u03C3\u03C4\u03AC \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C6\
      \u03BF\u03C1\u03B9\u03BA\u03AE\n# \u03B1\u03C0\u03BF\u03BA\u03C9\u03B4\u03B9\
      \u03BA\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 (Diff Decoder) \u03C0\u03B1\
      \u03C1\u03B1\u03BA\u03AC\u03C4\u03C9 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BB\u03C5\
      \u03C3\u03AF\u03B4\u03B1.\nDEROTATE = complex(np.cos(np.pi / 4), np.sin(np.pi\
      \ / 4))\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 60]
    rotation: 0
    state: enabled
