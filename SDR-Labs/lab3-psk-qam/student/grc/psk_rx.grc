- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ os\nimport csv\nimport datetime\n\n\nclass blk(gr.sync_block):\n    \"\"\"\
      \u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C3\u03B7\u03BC\u03B5\
      \u03AF\u03BF\u03C5 BER/SER \u03C3\u03B5 CSV, \u03BC\u03B5 \u03C4\u03BF \u03C0\
      \u03AC\u03C4\u03B7\u03BC\u03B1 \u03C4\u03BF\u03C5 QT GUI Message\n    Push Button\
      \ \xAB\u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C3\u03B7\u03BC\
      \u03B5\u03AF\u03BF\u03C5\xBB. \u0394\u03B9\u03B1\u03B2\u03AC\u03B6\u03B5\u03B9\
      \ \u03C4\u03B9\u03C2 \u03A4\u0395\u039B\u0395\u03A5\u03A4\u0391\u0399\u0395\u03A3\
      \ \u03C4\u03B9\u03BC\u03AD\u03C2 BER/SER \u03B1\u03C0\u03CC\n    \u03C4\u03B1\
      \ \u03B4\u03CD\u03BF \u03C1\u03B5\u03CD\u03BC\u03B1\u03C4\u03B1 \u03B5\u03B9\
      \u03C3\u03CC\u03B4\u03BF\u03C5 (\u03C4\u03B1 \u03AF\u03B4\u03B9\u03B1 \u03C0\
      \u03BF\u03C5 \u03C4\u03C1\u03BF\u03C6\u03BF\u03B4\u03BF\u03C4\u03BF\u03CD\u03BD\
      \ \u03C4\u03B1 QT GUI Number Sinks) \u03BA\u03B1\u03B9\n    \u03C0\u03C1\u03BF\
      \u03C3\u03B8\u03AD\u03C4\u03B5\u03B9 \u03BC\u03B9\u03B1 \u03B3\u03C1\u03B1\u03BC\
      \u03BC\u03AE \u03C3\u03C4\u03BF student/results/psk_measurements.csv (\u03C3\
      \u03C7\u03B5\u03C4\u03B9\u03BA\u03AC \u03BC\u03B5\n    \u03C4\u03B7 \u03B8\u03AD\
      \u03C3\u03B7 \u03B1\u03C5\u03C4\u03BF\u03CD \u03C4\u03BF\u03C5 \u03B1\u03C1\u03C7\
      \u03B5\u03AF\u03BF\u03C5, \u03B4\u03B7\u03BB. student/grc/../results/...). \u0394\
      \u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03C4\u03BF\n    \u03B1\
      \u03C1\u03C7\u03B5\u03AF\u03BF (\u03BC\u03B5 \u03B3\u03C1\u03B1\u03BC\u03BC\u03AE\
      \ \u03B5\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AF\u03B4\u03B1\u03C2)\
      \ \u03B1\u03BD \u03B4\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9\
      \ \u03AE\u03B4\u03B7. \u0397 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03C3\
      \u03C4\u03BF \u03B4\u03AF\u03C3\u03BA\u03BF\n    \u03B3\u03AF\u03BD\u03B5\u03C4\
      \u03B1\u03B9 \u03BC\u03CC\u03BD\u03BF \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\
      \ \u03C0\u03AC\u03C4\u03B7\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03BA\u03BF\u03C5\
      \u03BC\u03C0\u03B9\u03BF\u03CD (\u03BC\u03AE\u03BD\u03C5\u03BC\u03B1), \u03CC\
      \u03C7\u03B9 \u03B1\u03BD\u03AC \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1 \u2014\
      \ \u03BA\u03B1\u03BC\u03AF\u03B1\n    \u03B5\u03C0\u03AF\u03C0\u03C4\u03C9\u03C3\
      \u03B7 \u03C3\u03C4\u03BF\u03BD \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\
      \u03BA\u03CC \u03C7\u03C1\u03CC\u03BD\u03BF \u03C4\u03B7\u03C2 \u03C1\u03BF\u03AE\
      \u03C2.\"\"\"\n\n    def __init__(self, symbol_rate=20000.0):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='\u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\
      \u03C6\u03AE CSV',\n            in_sig=[np.float32, np.float32],\n         \
      \   out_sig=[],\n        )\n        self.symbol_rate = symbol_rate\n       \
      \ self._last_ber = 0.0\n        self._last_ser = 0.0\n        self.message_port_register_in(pmt.intern('trigger'))\n\
      \        self.set_msg_handler(pmt.intern('trigger'), self._on_trigger)\n   \
      \     # \u03A3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03C1\
      \u03BF\u03BC\u03AE \u03C9\u03C2 \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03A4\
      \u03A1\u0395\u03A7\u039F\u039D WORKING DIRECTORY \u03BA\u03B1\u03C4\u03AC \u03C4\
      \u03B7\u03BD \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B7\n        # (\u039F\
      \u03A7\u0399 __file__ \u2014 \u03C4\u03BF GRC \u03B5\u03BA\u03C4\u03B5\u03BB\
      \u03B5\u03AF exec() \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC\u03BD \u03C4\u03BF\
      \u03BD \u03BA\u03CE\u03B4\u03B9\u03BA\u03B1 \u03A7\u03A9\u03A1\u0399\u03A3 __file__\n\
      \        # \u03AE\u03B4\u03B7 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03C6\u03CC\
      \u03C1\u03C4\u03C9\u03C3\u03B7/\u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C4\u03BF\
      \u03C5 .grc, \u03C0\u03C1\u03B9\u03BD \u03BA\u03B1\u03BD \u03C4\u03C1\u03AD\u03BE\
      \u03B5\u03B9 \u03C4\u03BF flowgraph, \u03BF\u03C0\u03CC\u03C4\u03B5\n      \
      \  # \u03BC\u03B9\u03B1 \u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7 \u03B1\
      \u03C0\u03CC __file__ \u03B5\u03B4\u03CE \u03B8\u03B1 \u03AD\u03C3\u03C0\u03B1\
      \u03B3\u03B5 \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF \u03C4\u03BF \u03AC\u03BD\
      \u03BF\u03B9\u03B3\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03B1\u03C1\u03C7\u03B5\u03AF\
      \u03BF\u03C5).\n        # \u03A4\u03C1\u03AD\u03BE\u03C4\u03B5 \u03C4\u03BF\
      \ flowgraph \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03C6\u03AC\u03BA\u03B5\u03BB\
      \u03BF student/grc/, \u03CC\u03C0\u03C9\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B1\
      \ \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03B1\n        # \u03B5\u03C1\u03B3\
      \u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1, \u03CE\u03C3\u03C4\u03B5 \u03B7\
      \ \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\
      \u03BC\u03AE \u03BD\u03B1 \u03B5\u03C0\u03B9\u03BB\u03CD\u03B5\u03C4\u03B1\u03B9\
      \ \u03C3\u03C9\u03C3\u03C4\u03AC.\n        self._csv_path = os.path.join('..',\
      \ 'results', 'psk_measurements.csv')\n\n    def _on_trigger(self, msg):\n  \
      \      new_file = not os.path.exists(self._csv_path)\n        os.makedirs(os.path.dirname(self._csv_path),\
      \ exist_ok=True)\n        with open(self._csv_path, 'a', newline='') as f:\n\
      \            writer = csv.writer(f)\n            if new_file:\n            \
      \    writer.writerow(['timestamp', 'scheme', 'symbol_rate', 'ber', 'ser'])\n\
      \            writer.writerow([\n                datetime.datetime.now().isoformat(timespec='seconds'),\n\
      \                'QPSK',\n                f'{self.symbol_rate:.0f}',\n     \
      \           f'{self._last_ber:.6f}',\n                f'{self._last_ser:.6f}',\n\
      \            ])\n\n    def work(self, input_items, output_items):\n        ber\
      \ = input_items[0]\n        ser = input_items[1]\n        if len(ber):\n   \
      \         self._last_ber = float(ber[-1])\n        if len(ser):\n          \
      \  self._last_ser = float(ser[-1])\n        return len(ber)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    symbol_rate: symbol_rate
