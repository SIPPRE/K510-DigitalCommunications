      \ \u03C3\u03B7\u03BC\u03B5\u03AF\u03BF\u03C5 BER/SER \u03C3\u03B5 CSV, \u03BC\
      \u03B5 \u03C4\u03BF \u03C0\u03AC\u03C4\u03B7\u03BC\u03B1 \u03C4\u03BF\u03C5\
