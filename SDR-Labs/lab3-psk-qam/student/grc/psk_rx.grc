- name: digital_fll_band_edge_cc_0
  id: digital_fll_band_edge_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "\u03A7\u039F\u039D\u0394\u03A1\u0399\u039A\u0397 \u03B4\u03B9\u03CC\u03C1\
      \u03B8\u03C9\u03C3\u03B7 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\
      \u03C2 \u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\u03C2 (FLL Band-Edge). \u039F\
      \u03B9 \u03BA\u03C1\u03CD\u03C3\u03C4\u03B1\u03BB\u03BB\u03BF\u03B9 HackRF \u03BA\
      \u03B1\u03B9 RTL-SDR \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD\
      \ \u03BA\u03B1\u03C4\u03AC \u03B4\u03B5\u03BA\u03AC\u03B4\u03B5\u03C2 ppm \u2192\
      \ \u03C3\u03C4\u03B1 434 MHz \u03C4\u03BF offset \u03C6\u03C4\u03AC\u03BD\u03B5\
      \u03B9 \xB15-15 kHz, \u03A0\u039F\u039B\u03A5 \u03AD\u03BE\u03C9 \u03B1\u03C0\
      \u03CC \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03AD\u03BB\
      \u03BE\u03B7\u03C2 \u03C4\u03BF\u03C5 Costas Loop. \u03A7\u03C9\u03C1\u03AF\u03C2\
      \ \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF\
      \ \u03BF \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C0\
      \u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03C4\u03B1\u03B9 \u03C3\
      \u03C5\u03BD\u03B5\u03C7\u03CE\u03C2 (\u03C3\u03B7\u03BC\u03B5\u03AF\u03B1 \u03C0\
      \u03B1\u03BD\u03C4\u03BF\u03CD \u03C3\u03C4\u03BF \u03B4\u03B9\u03AC\u03B3\u03C1\
      \u03B1\u03BC\u03BC\u03B1 IQ). \u03A4\u03BF FLL \u03BA\u03BB\u03B5\u03B9\u03B4\
      \u03CE\u03BD\u03B5\u03B9 \u03C3\u03B5 offset \u03AD\u03C9\u03C2 ~\xB1symbol_rate/2\
      \ \u03BA\u03B1\u03B9 \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9 \u03BC\u03CC\u03BD\
      \u03BF \u03AD\u03BD\u03B1 \u03BC\u03B9\u03BA\u03C1\u03CC \u03C5\u03C0\u03CC\u03BB\
      \u03BF\u03B9\u03C0\u03BF \u03B3\u03B9\u03B1 \u03C4\u03BF Costas Loop."
    filter_size: int(11*actual_sps)+1
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: excess_bw
    samps_per_sym: actual_sps
    type: cc
    w: fll_bw
  states:
    bus_sink: false
    bus_source: false
