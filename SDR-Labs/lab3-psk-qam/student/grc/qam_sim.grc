options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "16-QAM προσομοίωση σε πραγματικό χρόνο (χωρίς SDR): TX -> μοντέλο
      καναλιού -> RX, με ρυθμιζόμενο θόρυβο, σφάλμα συχνότητας φέροντος και σφάλμα
      ρολογιού. student (lab3-psk-qam, Μέρος Β)."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: qam_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "16-QAM Προσομοίωση (χωρίς SDR)"
    window_size: (1300,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: clock_ppm
  id: variable_qtgui_range
  parameters:
    comment: "Σφάλμα ρολογιού δειγματοληψίας
      του «δέκτη» σε ppm — το epsilon του
      μοντέλου καναλιού."
    gui_hint: 1,0,1,2
    label: "Σφάλμα ρολογιού (ppm)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-300'
    step: '10'
    stop: '300'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable
  parameters:
    comment: "Εύρος βρόχου Costas = 2π/N"
    value: 2*np.pi/costas_bw_div
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 156]
    rotation: 0
    state: enabled
- name: costas_bw_div
  id: variable_qtgui_range
  parameters:
    comment: "ΖΩΝΤΑΝΗ ρύθμιση εύρους βρόχου
      Costas (= 2π/N). Στο 16-QAM μόνο τα 4
      γωνιακά σημεία «μοιάζουν» με QPSK στον
      ανιχνευτή 4ης τάξης — τα υπόλοιπα 12
      εισάγουν θόρυβο σχηματισμού (pattern
      noise). Εδώ (προσομοίωση, ΧΩΡΙΣ θόρυβο
      φάσης ταλαντωτών) όσο μεγαλύτερο το N
      τόσο καθαρότερος ο αστερισμός —
      δοκιμάστε N=100 (τιμή QPSK!) και δείτε
      το EVM να ανεβαίνει. Στον ΠΡΑΓΜΑΤΙΚΟ
      δέκτη (qam_rx.grc) υπάρχει και θόρυβος
      φάσης -> το βέλτιστο N είναι ενδιάμεσο
      (~300), όχι το μέγιστο."
    gui_hint: 1,2,1,2
    label: "Costas N (εύρος = 2π/N)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '50'
    step: '25'
    stop: '2000'
    value: '1000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 84]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
