- name: snippet_square_const
  id: snippet
  parameters:
    alias: ''
    code: |-
      # Κρατά τους αστερισμούς ΤΕΤΡΑΓΩΝΟΥΣ (ίση κλίμακα στους άξονες I και Q),
      # όποιο μέγεθος κι αν έχει το παράθυρο (π.χ. σε πλήρη οθόνη).
      # Το QT GUI Constellation Sink δεν έχει τέτοια επιλογή, οπότε κάθε
      # αστερισμός τυλίγεται σε ένα πλαίσιο που τον κεντράρει και κρατά
      # τετράγωνη την περιοχή σχεδίασης (canvas) του γραφήματος.
      from PyQt5 import Qt, QtCore

      class SquarePlot(Qt.QWidget):
          def __init__(self, inner):
              Qt.QWidget.__init__(self)
              self.inner = inner
              self.setMinimumSize(260, 260)
              self.setSizePolicy(Qt.QSizePolicy.Expanding, Qt.QSizePolicy.Expanding)

          def sizeHint(self):
              return QtCore.QSize(480, 480)

          def canvas(self):
              for w in self.inner.findChildren(Qt.QWidget):
                  if w.metaObject().className() == 'QwtPlotCanvas':
                      return w
              return None

          def fit(self):
              # περιθώρια = τίτλος, άξονες, υπόμνημα (ό,τι δεν είναι canvas)
              mw = mh = 0
              c = self.canvas()
              if c is not None and c.width() > 1 and c.height() > 1:
                  mw = self.inner.width() - c.width()
                  mh = self.inner.height() - c.height()
              side = max(50, min(self.width() - mw, self.height() - mh))
              w, h = side + mw, side + mh
              self.inner.setGeometry((self.width() - w) // 2,
                                     (self.height() - h) // 2, w, h)

          def resizeEvent(self, event):
              self.fit()
              # δεύτερο πέρασμα, αφού το γράφημα ξαναϋπολογίσει τα περιθώριά του
              QtCore.QTimer.singleShot(0, self.fit)
              QtCore.QTimer.singleShot(100, self.fit)

      def find_layout(layout, widget):
          for i in range(layout.count()):
              item = layout.itemAt(i)
              if item.widget() is widget:
                  return layout
              if item.layout() is not None:
                  found = find_layout(item.layout(), widget)
                  if found is not None:
                      return found
          return None

      self._square_plots = []
      for name in sorted(vars(self)):
          if not (name.startswith('_qtgui_const_sink_x') and name.endswith('_win')):
              continue
          win = getattr(self, name)
          parent = win.parentWidget()
          layout = find_layout(parent.layout(), win) if parent is not None else None
          if layout is None:
              continue
          box = SquarePlot(win)
          layout.replaceWidget(win, box)
          win.setParent(box)
          win.show()
          self._square_plots.append(box)
          # Στο πλέγμα: η γραμμή των αστερισμών παίρνει το περισσότερο ύψος,
          # οι γραμμές με ολισθητήρες μόνο όσο χρειάζονται.
          if isinstance(layout, Qt.QGridLayout):
              plots = [getattr(self, n) for n in vars(self)
                       if n.startswith('_qtgui_') and n.endswith('_win')
                       and 'number_sink' not in n and 'const_sink' not in n]
              for i in range(layout.count()):
                  row = layout.getItemPosition(i)[0]
                  w = layout.itemAt(i).widget()
                  if isinstance(w, SquarePlot):
                      layout.setRowStretch(row, 3)
                  elif any(w is p for p in plots):
                      layout.setRowStretch(row, 2)
                  elif layout.rowStretch(row) == 1:
                      layout.setRowStretch(row, 0)
    comment: "Τετράγωνοι αστερισμοί: κρατά ίση
      κλίμακα I/Q σε κάθε μέγεθος παραθύρου
      (και σε πλήρη οθόνη)"
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1100, 1060]
    rotation: 0
    state: enabled
