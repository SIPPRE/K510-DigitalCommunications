- name: channels_channel_model_0
  id: channels_channel_model
  parameters:
    affinity: ''
    alias: ''
    block_tags: 'False'
    comment: "\u03A4\u039F \xAB\u0391\u03A3\u03A5\u03A1\u039C\u0391\u03A4\u039F \u039A\
      \u0391\u039D\u0391\u039B\u0399\xBB \u03A4\u0397\u03A3 \u03A0\u03A1\u039F\u03A3\
      \u039F\u039C\u039F\u0399\u03A9\u03A3\u0397\u03A3: \u03C0\u03C1\u03BF\u03C3\u03B8\
      \u03AD\u03C4\u03B5\u03B9 \nAWGN \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF, \u03C3\
      \u03C6\u03AC\u03BB\u03BC\u03B1 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\
      \u03B1\u03C2 \u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\u03C2\n (\u03B4\u03B9\
      \u03B1\u03C6\u03BF\u03C1\u03AC \u03BA\u03C1\u03C5\u03C3\u03C4\u03AC\u03BB\u03BB\
      \u03C9\u03BD TX/RX) \u03BA\u03B1\u03B9 \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1\
      \ \u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BF\u03CD \n\u03B4\u03B5\u03B9\u03B3\
      \u03BC\u03B1\u03C4\u03BF\u03BB\u03B7\u03C8\u03AF\u03B1\u03C2 \u2014 \u03C4\u03B1\
      \ \u03C4\u03C1\u03AF\u03B1 \u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03B1\
      \ \u03C0\u03BF\u03C5 \u03B1\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03C9\u03C0\u03AF\
      \u03B6\u03B5\u03B9 \n\u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03B1\u03B3\u03BC\
      \u03B1\u03C4\u03B9\u03BA\u03CC\u03C2 \u03B4\u03AD\u03BA\u03C4\u03B7\u03C2. \u03A3\
      \u0397\u039C.: \u03C4\u03BF \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03C3\u03C5\
      \u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \n\u03C0\u03BF\u03BB\u03BB\u03B1\
      \u03C0\u03BB\u03B1\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B5\u03C0\
      \u03AF 1.00137, \u03CE\u03C3\u03C4\u03B5 \u03BF \u03BB\u03CC\u03B3\u03BF\u03C2\
      \ \u0394f/Rs \u03BD\u03B1 \n\u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9\
      \ \xAB\u03C3\u03C4\u03C1\u03BF\u03B3\u03B3\u03C5\u03BB\u03CC\u03C2\xBB \u2014\
      \ \u03B1\u03BB\u03BB\u03B9\u03CE\u03C2 \u03BF \u03B4\u03B1\u03BA\u03C4\u03CD\
      \u03BB\u03B9\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\
      \u03C3\u03BC\u03BF\u03CD \n\xAB\u03C0\u03C1\u03B9\u03BD\xBB \u03B8\u03B1 \u03C6\
      \u03B1\u03B9\u03BD\u03CC\u03C4\u03B1\u03BD \u03C3\u03B1\u03BD \u03BB\u03AF\u03B3\
      \u03B5\u03C2 \u03B1\u03BA\u03AF\u03BD\u03B7\u03C4\u03B5\u03C2 \u03BA\u03BF\u03C5\
      \u03BA\u03BA\u03AF\u03B4\u03B5\u03C2 \n(\u03C3\u03C4\u03C1\u03BF\u03B2\u03BF\
      \u03C3\u03BA\u03BF\u03C0\u03B9\u03BA\u03CC \u03C6\u03B1\u03B9\u03BD\u03CC\u03BC\
      \u03B5\u03BD\u03BF). \u039F\u03B9 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\
      \u03B9\u03BA\u03BF\u03AF \u03BA\u03C1\u03CD\u03C3\u03C4\u03B1\u03BB\u03BB\u03BF\
      \u03B9 \n\u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BF\u03C4\
      \u03AD \xAB\u03C3\u03C4\u03C1\u03BF\u03B3\u03B3\u03C5\u03BB\u03BF\u03AF\xBB."
    epsilon: 1.0 + clock_ppm*1e-6
    freq_offset: 1.00137*freq_offset_hz/samp_rate
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_voltage: noise_voltage
    seed: '42'
    taps: '[1.0]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1608, 472.0]
    rotation: 0
    state: enabled
- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
