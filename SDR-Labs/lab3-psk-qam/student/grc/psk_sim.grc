options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "QPSK \u03C0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03AF\u03C9\u03C3\
      \u03B7 \u03C3\u03B5 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\
      \ \u03C7\u03C1\u03CC\u03BD\u03BF (\u03C7\u03C9\u03C1\u03AF\u03C2 SDR): TX ->\
      \ \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF \u03BA\u03B1\u03BD\u03B1\u03BB\u03B9\
      \u03BF\u03CD -> RX, \u03BC\u03B5 \u03C1\u03C5\u03B8\u03BC\u03B9\u03B6\u03CC\u03BC\
      \u03B5\u03BD\u03BF \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF, \u03C3\u03C6\u03AC\u03BB\
      \u03BC\u03B1 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03C6\
      \u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03C6\u03AC\
      \u03BB\u03BC\u03B1 \u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BF\u03CD. student\
      \ (lab3-psk-qam)."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: psk_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "QPSK \u03A0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03AF\u03C9\u03C3\u03B7\
      \ (\u03C7\u03C9\u03C1\u03AF\u03C2 SDR)"
    window_size: (1300,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 64.0]
    rotation: 0
    state: enabled

