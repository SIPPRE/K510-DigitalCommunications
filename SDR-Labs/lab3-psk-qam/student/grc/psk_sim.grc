      \u03BE\u03B7\u03C2 \u03C4\u03BF\u03C5 Costas \u03BA\u03B1\u03B9 \u03BF \n\u03B1\
      \u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03B3\u03C5\u03C1\u03AF\
      \u03B6\u03B5\u03B9 \u03C3\u03C5\u03BD\u03B5\u03C7\u03CE\u03C2 \u2014 \n\u03B4\
      \u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03BF \u03B1\
      \u03C0\u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\
      \u03C4\u03B5 (bypass) \u03BA\u03B1\u03B9 \n\u03B1\u03BD\u03B5\u03B2\u03AC\u03C3\
      \u03C4\u03B5 \u03C4\u03BF \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03C3\u03C5\u03C7\
