- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: "import numpy as np\nfrom math import pi\nfrom cmath import exp\nfrom\
      \ gnuradio import digital\nfrom gnuradio.digital.utils import gray_code\n\n\
      # \u038A\u03B4\u03B9\u03B1 \u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03B1/\u03B1\
      \u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03AF\u03C7\u03B9\u03C3\u03B7 \u03BC\u03B5\
      \ psk_tx.grc / psk_rx.grc\nQPSK_POINTS = [complex(exp(2 * pi * (0 + 1j) * i\
      \ / 4)) for i in range(4)]\nQPSK_GRAY_MAP = list(gray_code.gray_code(4))\nQPSK_CONSTELLATION\
      \ = digital.constellation_calcdist(\n    QPSK_POINTS, list(range(4)), 4, 1).base()\n\
      DEROTATE = complex(np.cos(np.pi / 4), np.sin(np.pi / 4))"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16.0]
    rotation: 0
    state: enabled
- name: note_0
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "\u03A0\u03A1\u039F\u03A3\u039F\u039C\u039F\u0399\u03A9\u03A3\u0397 QPSK\
      \ \u03A7\u03A9\u03A1\u0399\u03A3 SDR: \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\
      \u03B7 \u03B7 \u03B6\u03B5\u03CD\u03BE\u03B7 (\u03C0\u03BF\u03BC\u03C0\u03CC\
      \u03C2 -> \u03BA\u03B1\u03BD\u03AC\u03BB\u03B9 -> \u03B4\u03AD\u03BA\u03C4\u03B7\
      \u03C2) \u03C4\u03C1\u03AD\u03C7\u03B5\u03B9 \u03C3\u03B5 \u03C0\u03C1\u03B1\
      \u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03C7\u03C1\u03CC\u03BD\u03BF \u03BC\
      \u03AD\u03C3\u03B1 \u03C3\u03C4\u03BF\u03BD \u03C5\u03C0\u03BF\u03BB\u03BF\u03B3\
      \u03B9\u03C3\u03C4\u03AE. \u039F \u03C0\u03BF\u03BC\u03C0\u03CC\u03C2 \u03BA\
      \u03B1\u03B9 \u03BF \u03B4\u03AD\u03BA\u03C4\u03B7\u03C2 \u03B5\u03AF\u03BD\u03B1\
      \u03B9 \u03BF\u03B9 \u0399\u0394\u0399\u0395\u03A3 \u03B1\u03BB\u03C5\u03C3\u03AF\
      \u03B4\u03B5\u03C2 \u03BC\u03B5 \u03C4\u03B1 psk_tx.grc / psk_rx.grc. \u03A4\
      \u03BF \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF \u03BA\u03B1\u03BD\u03B1\u03BB\
      \u03B9\u03BF\u03CD \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C4\u03B5\u03B9 \u03C4\
      \u03B9\u03C2 \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\
      \u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C4\u03AD\u03BB\u03B5\u03B9\u03B5\u03C2\
      : \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF AWGN, \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1\
      \ \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03C6\u03AD\u03C1\
      \u03BF\u03BD\u03C4\u03BF\u03C2 (\u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03BA\
      \u03C1\u03C5\u03C3\u03C4\u03AC\u03BB\u03BB\u03C9\u03BD TX/RX) \u03BA\u03B1\u03B9\
      \ \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BF\
      \u03CD \u03B4\u03B5\u03B9\u03B3\u03BC\u03B1\u03C4\u03BF\u03BB\u03B7\u03C8\u03AF\
      \u03B1\u03C2. \u03A0\u03B5\u03B9\u03C1\u03B1\u03BC\u03B1\u03C4\u03B9\u03C3\u03C4\
      \u03B5\u03AF\u03C4\u03B5: (1) \u03BC\u03B5 \u03CC\u03BB\u03B1 \u03C3\u03C4\u03BF\
      \ \u03BC\u03B7\u03B4\u03AD\u03BD \u03BF \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\
      \u03C3\u03BC\u03CC\u03C2 \xAB\u03C0\u03C1\u03B9\u03BD\xBB \u03BA\u03B1\u03B9\
      \ \xAB\u03BC\u03B5\u03C4\u03AC\xBB \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C7\
      \u03B5\u03B4\u03CC\u03BD \u03AF\u03B4\u03B9\u03BF\u03B9\xB7 (2) \u03B1\u03BD\
      \u03B5\u03B2\u03AC\u03C3\u03C4\u03B5 \u03C4\u03BF \u03C3\u03C6\u03AC\u03BB\u03BC\
      \u03B1 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03C3\u03C4\
      \u03B1 ~2 kHz \u2014 \u03BF \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\
      \u03CC\u03C2 \xAB\u03C0\u03C1\u03B9\u03BD\xBB (\u03BA\u03BB\u03AC\u03B4\u03BF\
      \u03C2 \u03A7\u03A9\u03A1\u0399\u03A3 \u03BA\u03B1\u03BC\u03AF\u03B1 \u03B4\u03B9\
      \u03CC\u03C1\u03B8\u03C9\u03C3\u03B7 \u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\
      \u03C2) \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B4\u03B1\u03BA\u03C4\u03CD\
      \u03BB\u03B9\u03BF\u03C2 (\u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\
      \u03B5\u03C4\u03B1\u03B9), \u03B1\u03BB\u03BB\u03AC FLL + Costas \u03C4\u03BF\
      \u03BD \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\
      \u03BD \u03C3\u03C4\u03BF\u03BD \xAB\u03BC\u03B5\u03C4\u03AC\xBB\xB7 \u03C3\u03C4\
      \u03B1 ~8 kHz (\u03C4\u03C5\u03C0\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03C6\
      \u03BF\u03C1\u03AC \u03BA\u03C1\u03C5\u03C3\u03C4\u03AC\u03BB\u03BB\u03C9\u03BD\
      \ \u03C3\u03C4\u03B1 434 MHz) \u03BF \u03B4\u03B1\u03BA\u03C4\u03CD\u03BB\u03B9\
      \u03BF\u03C2 \xAB\u03B3\u03B5\u03BC\u03AF\u03B6\u03B5\u03B9\xBB, \u03B3\u03B9\
      \u03B1\u03C4\u03AF \u03C4\u03BF \u03C3\u03AE\u03BC\u03B1 \u03C0\u03AD\u03C6\u03C4\
      \u03B5\u03B9 \u03B5\u03BD \u03BC\u03AD\u03C1\u03B5\u03B9 \u03AD\u03BE\u03C9\
      \ \u03B1\u03C0\u03CC \u03C4\u03BF matched \u03C6\u03AF\u03BB\u03C4\u03C1\u03BF\
      \ \u2014 \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF FLL \u03BC\u03C0\
      \u03B1\u03AF\u03BD\u03B5\u03B9 \u03A0\u03A1\u0399\u039D \u03B1\u03C0\u03CC \u03B1\
      \u03C5\u03C4\u03CC\xB7 (3) \u03B1\u03BD\u03B5\u03B2\u03AC\u03C3\u03C4\u03B5\
      \ \u03C4\u03BF\u03BD \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF \u03BA\u03B1\u03B9\
      \ \u03B4\u03B5\u03AF\u03C4\u03B5 \u03C4\u03B1 4 \u03C3\u03B7\u03BC\u03B5\u03AF\
      \u03B1 \u03BD\u03B1 \xAB\u03C6\u03BF\u03C5\u03C3\u03BA\u03CE\u03BD\u03BF\u03C5\
      \u03BD\xBB \u03BC\u03AD\u03C7\u03C1\u03B9 \u03BD\u03B1 \u03B1\u03C1\u03C7\u03AF\
      \u03C3\u03BF\u03C5\u03BD \u03BB\u03AC\u03B8\u03B7."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 640.0]
    rotation: 0
    state: enabled
