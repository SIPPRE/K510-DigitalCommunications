options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "QPSK προσομοίωση σε πραγματικό χρόνο (χωρίς SDR): TX -> μοντέλο
      καναλιού -> RX, με ρυθμιζόμενο θόρυβο, σφάλμα συχνότητας φέροντος και σφάλμα
      ρολογιού. student (lab3-psk-qam)."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: psk_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "QPSK Προσομοίωση (χωρίς SDR)"
    window_size: (1300,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: clock_ppm
  id: variable_qtgui_range
  parameters:
    comment: "Σφάλμα ρολογιού δειγματοληψίας
      του «δέκτη» σε ppm — το epsilon του
      μοντέλου καναλιού. Πραγματικοί
      κρύσταλλοι: 1-50 ppm."
    gui_hint: 1,0,1,3
    label: "Σφάλμα ρολογιού (ppm)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-300'
    step: '10'
    stop: '300'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable
  parameters:
    comment: "Εύρος βρόχου Costas (σταθερό)"
    value: 2*np.pi/100.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 156]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "Roll-off συντελεστής RRC"
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 156]
    rotation: 0
    state: enabled
- name: fll_bw
  id: variable
  parameters:
    comment: "Εύρος βρόχου FLL Band-Edge
      (χονδρική διόρθωση συχνότητας)"
    value: 2*np.pi/250.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 156]
    rotation: 0
    state: enabled
- name: freq_offset_hz
  id: variable_qtgui_range
  parameters:
    comment: "Σφάλμα συχνότητας φέροντος
      TX-RX (Hz). Στα 434 MHz, 20 ppm
      διαφορά κρυστάλλων = ~8,7 kHz —
      δοκιμάστε το!"
    gui_hint: 0,3,1,3
    label: "Σφάλμα συχνότητας φέροντος (Hz)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-15000'
    step: '500'
    stop: '15000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 12]
    rotation: 0
    state: enabled
- name: noise_voltage
  id: variable_qtgui_range
  parameters:
    comment: "Τάση θορύβου AWGN του
      μοντέλου καναλιού"
    gui_hint: 0,0,1,3
    label: "Θόρυβος (τάση)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '0.5'
    value: '0.05'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "Ρυθμός δειγματοληψίας
      προσομοίωσης = ρυθμός συμβόλου
      x δείγματα/σύμβολο"
    value: symbol_rate*sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 156]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Δείγματα ανά σύμβολο"
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [136, 156]
    rotation: 0
    state: enabled
- name: symbol_rate
  id: variable
  parameters:
    comment: "Ρυθμός συμβόλου (baud) —
      ίδιος με psk_tx.grc/psk_rx.grc"
    value: '20000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [248, 156]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable
  parameters:
    comment: "Εύρος βρόχου Symbol Sync (σταθερό)"
    value: '0.045'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 156]
    rotation: 0
    state: enabled
- name: analog_agc2_xx_0
  id: analog_agc2_xx
  parameters:
    affinity: ''
    alias: ''
    attack_rate: '0.1'
    comment: "Εξομάλυνση ισχύος —
      ίδιο στάδιο με το psk_rx.grc"
    decay_rate: 1e-2
    gain: '1.0'
    max_gain: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 692]
    rotation: 0
    state: enabled
- name: analog_random_source_x_0
  id: analog_random_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: "Τυχαία bytes = τυχαία
      ροή bits προς μετάδοση"
    max: '256'
    maxoutbuf: '0'
    min: '0'
    num_samps: '10000'
    repeat: 'True'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 300]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: "Σταθερή περιστροφή +45° μετά
      το Costas Loop (κλειδώνει σε διαγώνιο
      QPSK) — ίδια σύμβαση με το psk_rx.grc"
    const: DEROTATE
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 692]
    rotation: 0
    state: enabled
- name: blocks_packed_to_unpacked_xx_0
  id: blocks_packed_to_unpacked_xx
  parameters:
    affinity: ''
    alias: ''
    bits_per_chunk: '2'
    comment: 2 bits/chunk (QPSK)
    endianness: gr.GR_MSB_FIRST
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 300]
    rotation: 0
    state: enabled
- name: blocks_throttle_0
  id: blocks_throttle
  parameters:
    affinity: ''
    alias: ''
    comment: "Ρυθμίζει την προσομοίωση σε
      πραγματικό χρόνο (δεν υπάρχει
      hardware να δώσει ρυθμό)"
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1352, 300]
    rotation: 0
    state: enabled
- name: channels_channel_model_0
  id: channels_channel_model
  parameters:
    affinity: ''
    alias: ''
    block_tags: 'False'
    comment: "ΤΟ «ΑΣΥΡΜΑΤΟ ΚΑΝΑΛΙ» ΤΗΣ
      ΠΡΟΣΟΜΟΙΩΣΗΣ: προσθέτει AWGN
      θόρυβο, σφάλμα συχνότητας φέροντος
      (διαφορά κρυστάλλων TX/RX) και
      σφάλμα ρολογιού δειγματοληψίας —
      τα τρία πράγματα που αντιμετωπίζει κάθε πραγματικός δέκτης. ΣΗΜ.: το σφάλμα συχνότητας πολλαπλασιάζεται επί 1.00137, ώστε ο λόγος Δf/Rs να μην είναι «στρογγυλός» — αλλιώς ο δακτύλιος του αστερισμού «πριν» θα φαινόταν σαν λίγες ακίνητες κουκκίδες (στροβοσκοπικό φαινόμενο). Οι πραγματικοί κρύσταλλοι δεν είναι ποτέ «στρογγυλοί»."
    epsilon: 1.0 + clock_ppm*1e-6
    freq_offset: 1.00137*freq_offset_hz/samp_rate
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_voltage: noise_voltage
    seed: '42'
    taps: '[1.0]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 280]
    rotation: 0
    state: enabled
- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "Χαρτογράφηση σε σύμβολα QPSK
      (1 δείγμα/σύμβολο, ακριβή σημεία)"
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: complex
    symbol_table: QPSK_POINTS
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 300]
    rotation: 0
    state: enabled
- name: digital_costas_loop_cc_0
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "ΛΕΠΤΗ διόρθωση φάσης/συχνότητας
      φέροντος (4ης τάξης, για QPSK)"
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '4'
    use_snr: 'False'
    w: costas_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1016, 692]
    rotation: 0
    state: enabled
- name: digital_diff_encoder_bb_0
  id: digital_diff_encoder_bb
  parameters:
    affinity: ''
    alias: ''
    coding: digital.DIFF_DIFFERENTIAL
    comment: "Διαφορική κωδικοποίηση —
      η πληροφορία στη ΜΕΤΑΒΟΛΗ φάσης
      (λύνει την 4-πλή ασάφεια φάσης
      του δέκτη)"
    maxoutbuf: '0'
    minoutbuf: '0'
    modulus: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 300]
    rotation: 0
    state: enabled
- name: digital_fll_band_edge_cc_0
  id: digital_fll_band_edge_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "ΧΟΝΔΡΙΚΗ διόρθωση συχνότητας
      φέροντος (FLL Band-Edge). Χωρίς αυτό,
      σφάλμα > ~1 kHz είναι έξω από την
      περιοχή έλξης του Costas και ο
      αστερισμός γυρίζει συνεχώς —
      δοκιμάστε να το απενεργοποιήσετε
      (bypass) και ανεβάστε το σφάλμα
      συχνότητας!"
    filter_size: 11*sps+1
    rolloff: excess_bw
    samps_per_sym: sps
    type: cc
    w: fll_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 692]
    rotation: 0
    state: enabled
- name: digital_map_bb_0
  id: digital_map_bb
  parameters:
    affinity: ''
    alias: ''
    comment: "Αναδιάταξη Gray πριν τη
      διαφορική κωδικοποίηση"
    map: QPSK_GRAY_MAP
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 300]
    rotation: 0
    state: enabled
- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "Ανάκτηση χρονισμού συμβόλου
      (Gardner TED — ανεξάρτητος από
      περιστροφή αστερισμού) — παράγει
      1 δείγμα/σύμβολο"
    constellation: QPSK_CONSTELLATION
    damping: '1.0'
    loop_bw: sync_bw
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '128'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_MMSE_8TAP
    sps: sps
    ted_gain: '1.0'
    ted_type: digital.TED_GARDNER
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 692]
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: |-
      import numpy as np
      from math import pi
      from cmath import exp
      from gnuradio import digital
      from gnuradio.digital.utils import gray_code

      # Ίδια σύμβολα/αντιστοίχιση με psk_tx.grc / psk_rx.grc
      QPSK_POINTS = [complex(exp(2 * pi * (0 + 1j) * i / 4)) for i in range(4)]
      QPSK_GRAY_MAP = list(gray_code.gray_code(4))
      QPSK_CONSTELLATION = digital.constellation_calcdist(
          QPSK_POINTS, list(range(4)), 4, 1).base()
      DEROTATE = complex(np.cos(np.pi / 4), np.sin(np.pi / 4))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 84]
    rotation: 0
    state: enabled
- name: note_0
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "ΠΡΟΣΟΜΟΙΩΣΗ QPSK ΧΩΡΙΣ SDR: ολόκληρη η ζεύξη (πομπός -> κανάλι -> δέκτης)
      τρέχει σε πραγματικό χρόνο μέσα στον υπολογιστή. Ο πομπός και ο δέκτης είναι
      οι ΙΔΙΕΣ αλυσίδες με τα psk_tx.grc / psk_rx.grc. Το μοντέλο καναλιού
      προσθέτει τις τρεις πραγματικές ατέλειες: θόρυβο AWGN, σφάλμα συχνότητας
      φέροντος (διαφορά κρυστάλλων TX/RX) και σφάλμα ρολογιού δειγματοληψίας.
      Πειραματιστείτε: (1) με όλα στο μηδέν ο αστερισμός «πριν» και «μετά» είναι
      σχεδόν ίδιοι· (2) ανεβάστε το σφάλμα συχνότητας στα ~2 kHz — ο αστερισμός «πριν» (κλάδος ΧΩΡΙΣ καμία διόρθωση φέροντος) γίνεται δακτύλιος (περιστρέφεται), αλλά FLL + Costas τον σταθεροποιούν στον «μετά»· στα ~8 kHz (τυπική διαφορά κρυστάλλων στα 434 MHz) ο δακτύλιος «γεμίζει», γιατί το σήμα πέφτει εν μέρει έξω από το matched φίλτρο — γι' αυτό το FLL μπαίνει ΠΡΙΝ από αυτό· (3) ανεβάστε τον θόρυβο και
      δείτε τα 4 σημεία να «φουσκώνουν» μέχρι να αρχίσουν λάθη."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 396]
    rotation: 0
    state: enabled
