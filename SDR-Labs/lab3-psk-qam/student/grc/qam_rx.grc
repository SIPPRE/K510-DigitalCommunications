      \u03C4\u03B1\u03BD), \u03BF\u03C0\u03CC\u03C4\u03B5 \u03CC\u03BB\u03BF\u03C2\
      \ \u03BF \u03B1\u03C3\u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03BA\
      \u03AC\u03B8\u03B5\u03C4\u03B1\u03B9 ~5% \u03B5\u03BA\u03C4\u03CC\u03C2 \u03BA\
