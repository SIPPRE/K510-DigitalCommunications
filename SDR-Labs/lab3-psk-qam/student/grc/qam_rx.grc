- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n_S = 2.0 / np.sqrt(10.0)\
      \  # \u03B1\u03C0\u03CC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03C3\u03C4\u03B1\u03B8\
      \u03BC\u03CE\u03BD 16-QAM (\u03BC\u03AD\u03C3\u03B7 \u03B9\u03C3\u03C7\u03CD\
      \u03C2 1)\n\n\nclass blk(gr.sync_block):\n    \"\"\"\u0394\u03B9\u03BF\u03C1\
      \u03B8\u03C9\u03C4\u03AE\u03C2 DD-LMS \u03B5\u03BD\u03CC\u03C2 \u03C3\u03C5\u03BD\
      \u03C4\u03B5\u03BB\u03B5\u03C3\u03C4\u03AE (decision-directed, 1 complex tap).\n\
      \n    \u0393\u03B9\u03B1\u03C4\u03AF \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\
      \u03C4\u03B1\u03B9 (\u03B2\u03C1\u03AD\u03B8\u03B7\u03BA\u03B5 \u03C3\u03C4\u03B7\
      \u03BD \u03C0\u03C1\u03AC\u03BE\u03B7, \u03C3\u03C4\u03BF\u03BD \u03B1\u03AD\
      \u03C1\u03B1): \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF Costas Loop\n    \u03B1\
      \u03C0\u03BF\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD \u03C3\u03C6\u03AC\u03BB\u03BC\
      \u03B1\u03C4\u03B1 \u03C0\u03BF\u03C5 \u039A\u0391\u039D\u0395\u039D\u0391 \u03B5\
      \u03CD\u03C1\u03BF\u03C2 \u03B2\u03C1\u03CC\u03C7\u03BF\u03C5 Costas \u03B4\u03B5\
      \u03BD \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03BD\u03B5\u03B9:\n    (1) \u03C3\
      \u03C4\u03B1\u03C4\u03B9\u03BA\u03CC \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1 \u039A\
      \u039B\u0399\u039C\u0391\u039A\u0391\u03A3 \u2014 \u03C4\u03BF AGC \u03C3\u03C4\
      \u03B1\u03B8\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03C4\u03BF \u03BC\
      \u03AD\u03C3\u03BF \u03A0\u039B\u0391\u03A4\u039F\u03A3 \u03C3\u03C4\u03BF 1,\n\
      \    \u03B1\u03BB\u03BB\u03AC \u03C3\u03C4\u03BF 16-QAM \u03BC\u03AD\u03C3\u03BF\
      \ \u03C0\u03BB\u03AC\u03C4\u03BF\u03C2 \u2260 RMS \u03B9\u03C3\u03C7\u03CD\u03C2\
      \ (\u03C3\u03C4\u03BF QPSK \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\
      \u03B1\u03B9, \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC\n    \u03B5\u03BA\u03B5\
      \u03AF \u03B4\u03B5\u03BD \u03C6\u03B1\u03B9\u03BD\u03CC\u03C4\u03B1\u03BD),\
      \ \u03BF\u03C0\u03CC\u03C4\u03B5 \u03CC\u03BB\u03BF\u03C2 \u03BF \u03B1\u03C3\
      \u03C4\u03B5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03BA\u03AC\u03B8\u03B5\u03C4\
      \u03B1\u03B9 ~5% \u03B5\u03BA\u03C4\u03CC\u03C2 \u03BA\u03BB\u03AF\u03BC\u03B1\
      \u03BA\u03B1\u03C2\xB7\n    (2) \u03B1\u03C1\u03B3\u03AE \u03B1\u03BD\u03B1\u03C0\
      \u03BD\u03BF\u03AE \u03BA\u03AD\u03C1\u03B4\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5\
      \ AGC\xB7 (3) \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03BF \u03BB\u03AF\u03BA\
      \u03BD\u03B9\u03C3\u03BC\u03B1 \u03C6\u03AC\u03C3\u03B7\u03C2 \u03C4\u03C9\u03BD\
      \n    \u03C4\u03B1\u03BB\u03B1\u03BD\u03C4\u03C9\u03C4\u03CE\u03BD. \u039F \u03B2\
      \u03C1\u03CC\u03C7\u03BF\u03C2: y = w\xB7x, \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\
      \u03B7 d = \u03C0\u03BB\u03B7\u03C3\u03B9\u03AD\u03C3\u03C4\u03B5\u03C1\u03BF\
      \ \u03C3\u03B7\u03BC\u03B5\u03AF\u03BF\n    (\u03B4\u03B9\u03B1\u03C7\u03C9\u03C1\
      \u03AF\u03C3\u03B9\u03BC\u03B7 \u03B1\u03BD\u03AC \u03AC\u03BE\u03BF\u03BD\u03B1\
      \ \u03C3\u03C4\u03BF \u03C4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF\
      \ \u03C0\u03BB\u03AD\u03B3\u03BC\u03B1), w += \u03BC\xB7(d\u2212y)\xB7conj(x).\n\
      \    \u039F \u03BC\u03B9\u03B3\u03B1\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C3\u03C5\
      \u03BD\u03C4\u03B5\u03BB\u03B5\u03C3\u03C4\u03AE\u03C2 w \u03B4\u03B9\u03BF\u03C1\
      \u03B8\u03CE\u03BD\u03B5\u03B9 \u039C\u0391\u0396\u0399 \u03BA\u03AD\u03C1\u03B4\
      \u03BF\u03C2 \u039A\u0391\u0399 \u03C6\u03AC\u03C3\u03B7, \u03BC\u03B5 \u03B2\
      \u03AC\u03C3\u03B7 \u03C4\u03B9\u03C2\n    \u03AF\u03B4\u03B9\u03B5\u03C2 \u03C4\
      \u03B9\u03C2 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u2014 \u03C0\
      \u03BF\u03BB\u03CD \u03C0\u03B9\u03BF \xAB\u03BA\u03B1\u03B8\u03B1\u03C1\u03CC\
      \u03C2\xBB \u03B1\u03BD\u03B9\u03C7\u03BD\u03B5\u03C5\u03C4\u03AE\u03C2 \u03B1\
      \u03C0\u03CC \u03C4\u03BF\u03BD 4\u03B7\u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2\
      \n    \u03C4\u03BF\u03C5 Costas (\u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\
      \u03BF\u03B9\u03B5\u03AF \u03BA\u03B1\u03B9 \u03C4\u03B1 16 \u03C3\u03B7\u03BC\
      \u03B5\u03AF\u03B1, \u03CC\u03C7\u03B9 \u03BC\u03CC\u03BD\u03BF \u03C4\u03B1\
      \ 4 \u03B3\u03C9\u03BD\u03B9\u03B1\u03BA\u03AC).\n    \u0395\u03C0\u03B1\u03BB\
      \u03B7\u03B8\u03B5\u03C5\u03BC\u03AD\u03BD\u03BF: EVM 11.5% -> 6.7% \u03C3\u03C4\
      \u03B7\u03BD \u03C0\u03BB\u03AE\u03C1\u03B7 \u03B1\u03BB\u03C5\u03C3\u03AF\u03B4\
      \u03B1 \u03BC\u03B5 offset 8 kHz.\n    \u03A4\u03C1\u03AD\u03C7\u03B5\u03B9\
      \ \u03C3\u03C4\u03BF\u03BD \u03C1\u03C5\u03B8\u03BC\u03CC \u03C3\u03C5\u03BC\
      \u03B2\u03CC\u03BB\u03BF\u03C5 (20 kS/s) \u2014 \u03B2\u03C1\u03CC\u03C7\u03BF\
      \u03C2 Python OK (\u03CC\u03C0\u03C9\u03C2 \u03BF\n    \u03B4\u03B9\u03B1\u03BC\
      \u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\u03C2 \u0394\u03AD\u03BB\u03C4\u03B1 \u03C4\
      \u03BF\u03C5 Lab 1 \u03C3\u03C4\u03B1 48 kS/s).\"\"\"\n\n    def __init__(self,\
      \ mu=0.05):\n        gr.sync_block.__init__(\n            self,\n          \
      \  name='DD-LMS \u03B4\u03B9\u03BF\u03C1\u03B8\u03C9\u03C4\u03AE\u03C2 (1 tap)',\n\
      \            in_sig=[np.complex64],\n            out_sig=[np.complex64],\n \
      \       )\n        self.mu = float(mu)\n        self._w = 1.0 + 0.0j\n\n   \
      \ def work(self, input_items, output_items):\n        x = input_items[0]\n \
      \       out = output_items[0]\n        w = self._w\n        mu = float(self.mu)\n\
      \        for k in range(len(x)):\n            xi = complex(x[k])\n         \
      \   y = w * xi\n            ii = y.real / _S + 1.5\n            qq = y.imag\
      \ / _S + 1.5\n            ii = 0 if ii < 0 else (3 if ii > 3 else int(ii + 0.5))\n\
      \            qq = 0 if qq < 0 else (3 if qq > 3 else int(qq + 0.5))\n      \
      \      d = complex((ii - 1.5) * _S, (qq - 1.5) * _S)\n            w += mu *\
      \ (d - y) * xi.conjugate()\n            # \u03A3\u03C4\u03B5\u03BD\u03CC \u03CC\
      \u03C1\u03B9\u03BF |w|: \u03C4\u03BF AGC \u03B5\u03B3\u03B3\u03C5\u03AC\u03C4\
      \u03B1\u03B9 \u03BC\u03AD\u03C3\u03BF \u03C0\u03BB\u03AC\u03C4\u03BF\u03C2 ~1,\
      \ \u03AC\u03C1\u03B1 \u03C4\u03BF \u03C3\u03C9\u03C3\u03C4\u03CC\n         \
      \   # |w| \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03B1 ~0.9-1.1.\
      \ \u03A7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C5\u03C4\u03CC, \u03AD\u03BD\u03B1\
      \ \u03B1\u03C0\u03CC\u03C4\u03BF\u03BC\u03BF \u03BC\u03B5\u03C4\u03B1\u03B2\u03B1\
      \u03C4\u03B9\u03BA\u03CC\n            # \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\
      \ \u03BD\u03B1 \xAB\u03BA\u03B1\u03C4\u03B1\u03C1\u03C1\u03B5\u03CD\u03C3\u03B5\
      \u03B9\xBB \u03C4\u03BF w \u03C3\u03B5 \u03C8\u03B5\u03C5\u03B4\u03BF-\u03B9\
      \u03C3\u03BF\u03C1\u03C1\u03BF\u03C0\u03AF\u03B1 |w|~0.37 \u03CC\u03C0\u03BF\
      \u03C5\n            # \u039F\u039B\u0391 \u03C4\u03B1 \u03C3\u03CD\u03BC\u03B2\
      \u03BF\u03BB\u03B1 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03BF\u03BD\
      \u03C4\u03B1\u03B9 \u03C3\u03C4\u03B1 4 \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\
      \u03B9\u03BA\u03AC \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1\n            # (scale-collapse\
      \ false lock, \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AC\u03C7\u03B8\u03B7\u03BA\
      \u03B5 \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03AC\u03BE\u03B7).\n         \
      \   if not (0.5 < abs(w) < 2.0):\n                w = 1.0 + 0.0j\n         \
      \   out[k] = y\n        self._w = w\n        return len(x)\n"
    affinity: ''
    alias: ''
    comment: "\u0394\u03B9\u03CC\u03C1\u03B8\u03C9\u03C3\u03B7 \u03BA\u03BB\u03AF\u03BC\
      \u03B1\u03BA\u03B1\u03C2/\u03BA\u03AD\u03C1\u03B4\u03BF\u03C5\u03C2/ \u03C5\u03C0\
      \u03CC\u03BB\u03BF\u03B9\u03C0\u03B7\u03C2 \u03C6\u03AC\u03C3\u03B7\u03C2 \u03BC\
      \u03B5 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u2014 \u03B2\u03BB\
      . docstring"
    maxoutbuf: '0'
    minoutbuf: '0'
    mu: dd_mu
  states:
    _io_cache: "('DD-LMS \u03B4\u03B9\u03BF\u03C1\u03B8\u03C9\u03C4\u03AE\u03C2 (1\
      \ tap)', 'blk', [('mu', '0.05')], [('0', 'complex', 1)], [('0', 'complex', 1)],\
      \ \"\u0394\u03B9\u03BF\u03C1\u03B8\u03C9\u03C4\u03AE\u03C2 DD-LMS \u03B5\u03BD\
      \u03CC\u03C2 \u03C3\u03C5\u03BD\u03C4\u03B5\u03BB\u03B5\u03C3\u03C4\u03AE (decision-directed,\
      \ 1 complex tap).\\n\\n    \u0393\u03B9\u03B1\u03C4\u03AF \u03C7\u03C1\u03B5\
      \u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 (\u03B2\u03C1\u03AD\u03B8\u03B7\u03BA\
      \u03B5 \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03AC\u03BE\u03B7, \u03C3\u03C4\
      \u03BF\u03BD \u03B1\u03AD\u03C1\u03B1): \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\
      \ Costas Loop\\n    \u03B1\u03C0\u03BF\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD \u03C3\
      \u03C6\u03AC\u03BB\u03BC\u03B1\u03C4\u03B1 \u03C0\u03BF\u03C5 \u039A\u0391\u039D\
      \u0395\u039D\u0391 \u03B5\u03CD\u03C1\u03BF\u03C2 \u03B2\u03C1\u03CC\u03C7\u03BF\
      \u03C5 Costas \u03B4\u03B5\u03BD \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03BD\u03B5\
      \u03B9:\\n    (1) \u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC \u03C3\u03C6\u03AC\
      \u03BB\u03BC\u03B1 \u039A\u039B\u0399\u039C\u0391\u039A\u0391\u03A3 \u2014 \u03C4\
      \u03BF AGC \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03B5\
      \u03AF \u03C4\u03BF \u03BC\u03AD\u03C3\u03BF \u03A0\u039B\u0391\u03A4\u039F\u03A3\
      \ \u03C3\u03C4\u03BF 1,\\n    \u03B1\u03BB\u03BB\u03AC \u03C3\u03C4\u03BF 16-QAM\
      \ \u03BC\u03AD\u03C3\u03BF \u03C0\u03BB\u03AC\u03C4\u03BF\u03C2 \u2260 RMS \u03B9\
      \u03C3\u03C7\u03CD\u03C2 (\u03C3\u03C4\u03BF QPSK \u03C4\u03B1\u03C5\u03C4\u03AF\
