- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: "\u039A\u03AD\u03C1\u03B4\u03BF\u03C2 RF \u03C4\u03BF\u03C5 RTL-SDR.\
      \ \u03A0\u03A1\u039F\u03A3\u039F\u03A7\u0397 \u03C3\u03C4\u03BF 16-QAM: \u03C0\
      \u03BF\u03BB\u03CD \u03C5\u03C8\u03B7\u03BB\u03CC \u03BA\u03AD\u03C1\u03B4\u03BF\
      \u03C2 -> \u03BC\u03B7-\u03B3\u03C1\u03B1\u03BC\u03BC\u03B9\u03BA\u03CC\u03C4\
      \u03B7\u03C4\u03B1/\u03C8\u03B1\u03BB\u03AF\u03B4\u03B9\u03C3\u03BC\u03B1 \u03C3\
      \u03C4\u03BF\u03BD \u03B4\u03AD\u03BA\u03C4\u03B7 -> \u03C4\u03B1 \u03B5\u03BE\
      \u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AC \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1\
      \ \u03C0\u03B1\u03C1\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03BD\u03BF\u03BD\u03C4\
      \u03B1\u03B9 (\u03B1\u03BD\u03B5\u03B2\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C4\u03BF\
      \ EVM)"
    gui_hint: 0,2,1,2
    label: "\u039A\u03AD\u03C1\u03B4\u03BF\u03C2 RF (dB)"
