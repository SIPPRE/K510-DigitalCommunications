      \u03C2 \u03C4\u03BF\u03C5 AGC\xB7 (3) \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\
      \u03BF \u03BB\u03AF\u03BA\u03BD\u03B9\u03C3\u03BC\u03B1 \u03C6\u03AC\u03C3\u03B7\
      \u03C2 \u03C4\u03C9\u03BD\\n    \u03C4\u03B1\u03BB\u03B1\u03BD\u03C4\u03C9\u03C4\
      \u03CE\u03BD. \u039F \u03B2\u03C1\u03CC\u03C7\u03BF\u03C2: y = w\xB7x, \u03B1\
      \u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 d = \u03C0\u03BB\u03B7\u03C3\u03B9\u03AD\
      \u03C3\u03C4\u03B5\u03C1\u03BF \u03C3\u03B7\u03BC\u03B5\u03AF\u03BF\\n    (\u03B4\
      \u03B9\u03B1\u03C7\u03C9\u03C1\u03AF\u03C3\u03B9\u03BC\u03B7 \u03B1\u03BD\u03AC\
      \ \u03AC\u03BE\u03BF\u03BD\u03B1 \u03C3\u03C4\u03BF \u03C4\u03B5\u03C4\u03C1\
      \u03AC\u03B3\u03C9\u03BD\u03BF \u03C0\u03BB\u03AD\u03B3\u03BC\u03B1), w += \u03BC\
      \xB7(d\u2212y)\xB7conj(x).\\n    \u039F \u03BC\u03B9\u03B3\u03B1\u03B4\u03B9\
      \u03BA\u03CC\u03C2 \u03C3\u03C5\u03BD\u03C4\u03B5\u03BB\u03B5\u03C3\u03C4\u03AE\
      \u03C2 w \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03BD\u03B5\u03B9 \u039C\u0391\
      \u0396\u0399 \u03BA\u03AD\u03C1\u03B4\u03BF\u03C2 \u039A\u0391\u0399 \u03C6\u03AC\
      \u03C3\u03B7, \u03BC\u03B5 \u03B2\u03AC\u03C3\u03B7 \u03C4\u03B9\u03C2\\n  \
      \  \u03AF\u03B4\u03B9\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03B1\u03C0\u03BF\u03C6\
      \u03AC\u03C3\u03B5\u03B9\u03C2 \u2014 \u03C0\u03BF\u03BB\u03CD \u03C0\u03B9\u03BF\
      \ \xAB\u03BA\u03B1\u03B8\u03B1\u03C1\u03CC\u03C2\xBB \u03B1\u03BD\u03B9\u03C7\
      \u03BD\u03B5\u03C5\u03C4\u03AE\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD 4\u03B7\
      \u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2\\n    \u03C4\u03BF\u03C5 Costas (\u03C7\
      \u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03BA\u03B1\
      \u03B9 \u03C4\u03B1 16 \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1, \u03CC\u03C7\u03B9\
      \ \u03BC\u03CC\u03BD\u03BF \u03C4\u03B1 4 \u03B3\u03C9\u03BD\u03B9\u03B1\u03BA\
      \u03AC).\\n    \u0395\u03C0\u03B1\u03BB\u03B7\u03B8\u03B5\u03C5\u03BC\u03AD\u03BD\
      \u03BF: EVM 11.5% -> 6.7% \u03C3\u03C4\u03B7\u03BD \u03C0\u03BB\u03AE\u03C1\u03B7\
      \ \u03B1\u03BB\u03C5\u03C3\u03AF\u03B4\u03B1 \u03BC\u03B5 offset 8 kHz.\\n \
      \   \u03A4\u03C1\u03AD\u03C7\u03B5\u03B9 \u03C3\u03C4\u03BF\u03BD \u03C1\u03C5\
      \u03B8\u03BC\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03BF\u03C5 (20 kS/s)\
      \ \u2014 \u03B2\u03C1\u03CC\u03C7\u03BF\u03C2 Python OK (\u03CC\u03C0\u03C9\u03C2\
      \ \u03BF\\n    \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03C9\u03C4\u03AE\u03C2\
      \ \u0394\u03AD\u03BB\u03C4\u03B1 \u03C4\u03BF\u03C5 Lab 1 \u03C3\u03C4\u03B1\
      \ 48 kS/s).\", ['mu'])"
