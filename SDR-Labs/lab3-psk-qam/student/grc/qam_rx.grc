- name: freq_xlating_fir_filter_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: lo_offset
    comment: "\u039C\u03B5\u03C4\u03B1\u03C4\u03CC\u03C0\u03B9\u03C3\u03B7 \u03BA\u03B1\
      \u03C4\u03AC lo_offset (offset tuning) + \u03C6\u03AF\u03BB\u03C4\u03C1\u03BF\
      \ \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2 \u03BA\u03B1\u03BD\u03B1\u03BB\
      \u03B9\u03BF\u03CD + \u03B4\u03B5\u03BA\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2\
      \ \u03C3\u03C4\u03BF\u03BD \u03C1\u03C5\u03B8\u03BC\u03CC quad_rate. Cutoff\
      \ = \u03BC\u03B9\u03C3\u03CC \u03B5\u03CD\u03C1\u03BF\u03C2 \u03C3\u03AE\u03BC\
      \u03B1\u03C4\u03BF\u03C2 + 15 kHz \u03C0\u03B5\u03C1\u03B9\u03B8\u03CE\u03C1\
      \u03B9\u03BF \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1\
      \ \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03C4\u03C9\u03BD\
      \ \u03BA\u03C1\u03C5\u03C3\u03C4\u03AC\u03BB\u03BB\u03C9\u03BD (\u03C4\u03BF\
      \ \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03BD\u03B5\u03B9 \u03BC\u03B5\u03C4\u03AC\
      \ \u03C4\u03BF FLL)."
