- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nWINDOW = 4096\n\n\
      \nclass blk(gr.sync_block):\n    \"\"\"\u039C\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\
      \u03C2 EVM (%): \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03BB\u03B7\u03C6\
      \u03B8\u03AD\u03BD \u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03BF \u03B2\u03C1\u03AF\
      \u03C3\u03BA\u03B5\u03B9 \u03C4\u03BF \u03C0\u03BB\u03B7\u03C3\u03B9\u03AD\u03C3\
      \u03C4\u03B5\u03C1\u03BF \u03B1\u03C0\u03CC\n    \u03C4\u03B1 16 \u03B9\u03B4\
      \u03B1\u03BD\u03B9\u03BA\u03AC \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1 16-QAM \u03BA\
      \u03B1\u03B9 \u03BC\u03B5\u03C4\u03C1\u03AC \u03C4\u03BF \u03B4\u03B9\u03B1\u03BD\
      \u03C5\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03C3\u03C6\u03AC\u03BB\u03BC\
      \u03B1. EVM =\n    RMS(\u03C3\u03C6\u03AC\u03BB\u03BC\u03B1) / RMS(\u03B9\u03B4\
      \u03B1\u03BD\u03B9\u03BA\u03AE \u03B9\u03C3\u03C7\u03CD\u03C2 = 1) x 100%, \u03C3\
      \u03B5 \u03BA\u03C5\u03BB\u03B9\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03B1\u03C1\
      \u03AC\u03B8\u03C5\u03C1\u03BF 4096\n    \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\
      \u03C9\u03BD. \u03A4\u03BF EVM \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BD\u03B5\
      \u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03BF \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD\
      \ 4-\u03C0\u03BB\u03AE \u03B1\u03C3\u03AC\u03C6\u03B5\u03B9\u03B1 \u03C6\u03AC\
      \u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5\n    Costas (\u03C4\u03BF \u03C4\u03B5\
      \u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF 16-QAM \u03B5\u03AF\u03BD\u03B1\u03B9\
      \ \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03C1\u03B9\u03BA\u03CC \u03C3\u03C4\u03B9\
      \u03C2 \u03C3\u03C4\u03C1\u03BF\u03C6\u03AD\u03C2 90\xB0), \u03BF\u03C0\u03CC\
      \u03C4\u03B5\n    \u03B4\u03B5\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\
      \u03C4\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B9\u03BA\u03AE \u03BA\
      \u03C9\u03B4\u03B9\u03BA\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03AE \u03C3\
      \u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C0\u03BB\
      \u03B1\u03B9\u03C3\u03AF\u03BF\u03C5 \u2014\n    \u03BA\u03B1\u03C4\u03AC\u03BB\
      \u03BB\u03B7\u03BB\u03BF \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CC \u03BC\u03AD\
      \u03C4\u03C1\u03BF \u03C0\u03BF\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03B3\
      \u03B9\u03B1 \u03C3\u03CD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7 QPSK/16-QAM.\n\
      \    \u03A4\u03C1\u03AD\u03C7\u03B5\u03B9 \u03C3\u03C4\u03BF\u03BD \u03C1\u03C5\
      \u03B8\u03BC\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03BF\u03C5 (20 kS/s)\
      \ \u2014 \u03B1\u03C3\u03C6\u03B1\u03BB\u03AD\u03C2 \u03B3\u03B9\u03B1 epy_block.\"\
      \"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='\u039C\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2\
      \ EVM',\n            in_sig=[np.complex64],\n            out_sig=[np.float32],\n\
      \        )\n        lv = np.array([-3.0, -1.0, 1.0, 3.0], dtype=np.float32)\
      \ / np.float32(np.sqrt(10.0))\n        self._ideal = (lv[:, None] + 1j * lv[None,\
      \ :]).flatten().astype(np.complex64)\n        self._buf = np.zeros(WINDOW, dtype=np.float32)\n\
      \        self._ptr = 0\n        self._filled = 0\n        self.evm = 0.0\n\n\
      \    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        d = np.abs(x[:, None] - self._ideal[None, :]).min(axis=1)\n       \
      \ e2 = (d * d).astype(np.float32)\n        n = len(e2)\n        L = WINDOW\n\
      \        if n >= L:\n            self._buf[:] = e2[-L:]\n            self._ptr\
      \ = 0\n            self._filled = L\n        else:\n            end = self._ptr\
      \ + n\n            if end <= L:\n                self._buf[self._ptr:end] =\
      \ e2\n            else:\n                k = L - self._ptr\n               \
      \ self._buf[self._ptr:] = e2[:k]\n                self._buf[:end - L] = e2[k:]\n\
      \            self._ptr = end % L\n            self._filled = min(self._filled\
      \ + n, L)\n        if self._filled:\n            self.evm = float(np.sqrt(self._buf[:self._filled].mean())\
      \ * 100.0)\n        output_items[0][:] = self.evm\n        return n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('\u039C\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 EVM', 'blk', [],\
      \ [('0', 'complex', 1)], [('0', 'float', 1)], '\u039C\u03B5\u03C4\u03C1\u03B7\
      \u03C4\u03AE\u03C2 EVM (%): \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03BB\
      \u03B7\u03C6\u03B8\u03AD\u03BD \u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03BF \u03B2\
      \u03C1\u03AF\u03C3\u03BA\u03B5\u03B9 \u03C4\u03BF \u03C0\u03BB\u03B7\u03C3\u03B9\
      \u03AD\u03C3\u03C4\u03B5\u03C1\u03BF \u03B1\u03C0\u03CC\\n    \u03C4\u03B1 16\
      \ \u03B9\u03B4\u03B1\u03BD\u03B9\u03BA\u03AC \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1\
      \ 16-QAM \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03C1\u03AC \u03C4\u03BF \u03B4\
      \u03B9\u03B1\u03BD\u03C5\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03C3\u03C6\
      \u03AC\u03BB\u03BC\u03B1. EVM =\\n    RMS(\u03C3\u03C6\u03AC\u03BB\u03BC\u03B1\
      ) / RMS(\u03B9\u03B4\u03B1\u03BD\u03B9\u03BA\u03AE \u03B9\u03C3\u03C7\u03CD\u03C2\
      \ = 1) x 100%, \u03C3\u03B5 \u03BA\u03C5\u03BB\u03B9\u03CC\u03BC\u03B5\u03BD\
      \u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF 4096\\n    \u03C3\u03C5\
      \u03BC\u03B2\u03CC\u03BB\u03C9\u03BD. \u03A4\u03BF EVM \u03B5\u03AF\u03BD\u03B1\
      \u03B9 \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03BF \u03B1\u03C0\
      \u03CC \u03C4\u03B7\u03BD 4-\u03C0\u03BB\u03AE \u03B1\u03C3\u03AC\u03C6\u03B5\
      \u03B9\u03B1 \u03C6\u03AC\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5\\n    Costas\
      \ (\u03C4\u03BF \u03C4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF 16-QAM\
      \ \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03C1\u03B9\
      \u03BA\u03CC \u03C3\u03C4\u03B9\u03C2 \u03C3\u03C4\u03C1\u03BF\u03C6\u03AD\u03C2\
      \ 90\xB0), \u03BF\u03C0\u03CC\u03C4\u03B5\\n    \u03B4\u03B5\u03BD \u03C7\u03C1\
      \u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\
      \u03C1\u03B9\u03BA\u03AE \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03C0\u03BF\u03AF\
      \u03B7\u03C3\u03B7 \u03AE \u03C3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\
      \u03BC\u03CC\u03C2 \u03C0\u03BB\u03B1\u03B9\u03C3\u03AF\u03BF\u03C5 \u2014\\\
      n    \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03BF \u03BA\u03B1\u03B9\
      \ \u03B1\u03C0\u03BB\u03CC \u03BC\u03AD\u03C4\u03C1\u03BF \u03C0\u03BF\u03B9\
      \u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03B3\u03B9\u03B1 \u03C3\u03CD\u03B3\u03BA\
      \u03C1\u03B9\u03C3\u03B7 QPSK/16-QAM.\\n    \u03A4\u03C1\u03AD\u03C7\u03B5\u03B9\
      \ \u03C3\u03C4\u03BF\u03BD \u03C1\u03C5\u03B8\u03BC\u03CC \u03C3\u03C5\u03BC\
      \u03B2\u03CC\u03BB\u03BF\u03C5 (20 kS/s) \u2014 \u03B1\u03C3\u03C6\u03B1\u03BB\
