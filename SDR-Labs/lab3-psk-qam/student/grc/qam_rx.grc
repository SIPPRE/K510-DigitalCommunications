options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "16-QAM RX (RTL-SDR): FLL + matched RRC + Symbol Sync (Gardner) +\
      \ Costas + \u03BC\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 EVM. student (lab3-psk-qam,\
      \ \u039C\u03AD\u03C1\u03BF\u03C2 \u0392)."
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: qam_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 16-QAM Receiver (RTL-SDR)
    window_size: (1300,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: actual_sps
  id: variable
  parameters:
    comment: "\u03A0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC \u03B4\u03B5\
      \u03AF\u03B3\u03BC\u03B1\u03C4\u03B1/\u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03BF\
      \ (\u03CC\u03C7\u03B9 \u03B1\u03C0\u03B1\u03C1\u03B1\u03AF\u03C4\u03B7\u03C4\
      \u03B1 \u03B1\u03BA\u03AD\u03C1\u03B1\u03B9\u03BF)"
    value: quad_rate/symbol_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 228]
    rotation: 0
    state: enabled
- name: channel_decim
  id: variable
  parameters:
    comment: "\u0394\u03B5\u03BA\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C6\u03AF\
      \u03BB\u03C4\u03C1\u03BF\u03C5 \u03BA\u03B1\u03BD\u03B1\u03BB\u03B9\u03BF\u03CD\
      \ (\u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03B1\u03C3\u03C4\u03B9\u03BA\
      \u03AE \u03C0\u03B1\u03C1\u03AC\u03BC\u03B5\u03C4\u03C1\u03BF\u03C2 \u2014 \u03B1\
      \u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03BC\u03CC\u03BD\u03BF \u03BC\u03B5 Kill+Run)"
    value: max(1, int(round(rtl_samp_rate/(symbol_rate*4))))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 228]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable
  parameters:
    comment: "\u0395\u03CD\u03C1\u03BF\u03C2 \u03B2\u03C1\u03CC\u03C7\u03BF\u03C5\
      \ Costas = 2\u03C0/N, \u03BC\u03B5 \u03C4\u03BF N \u03B1\u03C0\u03CC \u03C4\u03BF\
      \u03BD \u03BF\u03BB\u03B9\u03C3\u03B8\u03B7\u03C4\u03AE\u03C1\u03B1"
    value: 2*np.pi/costas_bw_div
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 228]
    rotation: 0
    state: enabled
- name: costas_bw_div
  id: variable_qtgui_range
  parameters:
    comment: "\u0396\u03A9\u039D\u03A4\u0391\u039D\u0397 \u03C1\u03CD\u03B8\u03BC\u03B9\
      \u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B5\u03CD\u03C1\u03BF\u03C5\u03C2 \u03B2\u03C1\
      \u03CC\u03C7\u03BF\u03C5 Costas (= 2\u03C0/N). \u03A4\u03BF 16-QAM \u03AD\u03C7\
      \u03B5\u03B9 \u03B1\u03BD\u03C4\u03B9\u03BA\u03C1\u03BF\u03C5\u03CC\u03BC\u03B5\
      \u03BD\u03B5\u03C2 \u03B1\u03C0\u03B1\u03B9\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2\
      : (\u03B1) \u03A3\u03A4\u0395\u039D\u039F\u03A3 \u03B2\u03C1\u03CC\u03C7\u03BF\
      \u03C2 (\u03BC\u03B5\u03B3\u03AC\u03BB\u03BF N) \u03C6\u03B9\u03BB\u03C4\u03C1\
      \u03AC\u03C1\u03B5\u03B9 \u03C4\u03BF\u03BD \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF\
      \ \u03C3\u03C7\u03B7\u03BC\u03B1\u03C4\u03B9\u03C3\u03BC\u03BF\u03CD \u03C4\u03C9\
      \u03BD 12 \u03BC\u03B7-\u03B3\u03C9\u03BD\u03B9\u03B1\u03BA\u03CE\u03BD \u03C3\
      \u03B7\u03BC\u03B5\u03AF\u03C9\u03BD (\u03BC\u03CC\u03BD\u03BF \u03C4\u03B1\
      \ 4 \u03B3\u03C9\u03BD\u03B9\u03B1\u03BA\u03AC \xAB\u03BC\u03BF\u03B9\u03AC\u03B6\
      \u03BF\u03C5\u03BD\xBB \u03BC\u03B5 QPSK \u03C3\u03C4\u03BF\u03BD \u03B1\u03BD\
      \u03B9\u03C7\u03BD\u03B5\u03C5\u03C4\u03AE 4\u03B7\u03C2 \u03C4\u03AC\u03BE\u03B7\
      \u03C2)\xB7 (\u03B2) \u03A6\u0391\u03A1\u0394\u03A5\u03A3 \u03B2\u03C1\u03CC\
      \u03C7\u03BF\u03C2 (\u03BC\u03B9\u03BA\u03C1\u03CC N) \u03C0\u03B1\u03C1\u03B1\
      \u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF \u03C4\u03BF\u03BD \u03B8\u03CC\
      \u03C1\u03C5\u03B2\u03BF \u03C6\u03AC\u03C3\u03B7\u03C2 \u03C4\u03C9\u03BD \u03C0\
      \u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CE\u03BD \u03C4\u03B1\u03BB\
      \u03B1\u03BD\u03C4\u03C9\u03C4\u03CE\u03BD HackRF/RTL-SDR. \u03A0\u03BF\u03BB\
      \u03CD \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF N -> \u03C4\u03B1 \u03C3\u03B7\u03BC\
      \u03B5\u03AF\u03B1 \xAB\u03C3\u03AD\u03C1\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9\
      \xBB \u03C3\u03B5 \u03C4\u03CC\u03BE\u03B1 (\u03BF \u03B1\u03C3\u03C4\u03B5\u03C1\
      \u03B9\u03C3\u03BC\u03CC\u03C2 \u03BB\u03B9\u03BA\u03BD\u03AF\u03B6\u03B5\u03C4\
      \u03B1\u03B9)\xB7 \u03C0\u03BF\u03BB\u03CD \u03BC\u03B9\u03BA\u03C1\u03CC N\
      \ -> \u03B8\u03BF\u03BB\u03AC, \u03C6\u03BF\u03C5\u03C3\u03BA\u03C9\u03BC\u03AD\
      \u03BD\u03B1 \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1. \u0392\u03C1\u03B5\u03AF\u03C4\
      \u03B5 \u03C4\u03BF \u03B2\u03AD\u03BB\u03C4\u03B9\u03C3\u03C4\u03BF \u0396\u03A9\
      \u039D\u03A4\u0391\u039D\u0391 \u03C0\u03B1\u03C1\u03B1\u03C4\u03B7\u03C1\u03CE\
      \u03BD\u03C4\u03B1\u03C2 \u03C4\u03BF EVM \u2014 \u03B5\u03BE\u03B1\u03C1\u03C4\
      \u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B1 \u03C0\u03C1\u03B1\u03B3\
      \u03BC\u03B1\u03C4\u03B9\u03BA\u03AC radios, \u03B4\u03B5\u03BD \u03C0\u03C1\
      \u03BF\u03C3\u03BF\u03BC\u03BF\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9!"
    gui_hint: 2,2,1,2
    label: "Costas N (\u03B5\u03CD\u03C1\u03BF\u03C2 = 2\u03C0/N)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '50'
    step: '25'
    stop: '2000'
    value: '300'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 300]
    rotation: 0
    state: enabled
- name: dd_mu
  id: variable_qtgui_range
  parameters:
    comment: "\u0392\u03AE\u03BC\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\
      \u03B3\u03AE\u03C2 \u03BC \u03C4\u03BF\u03C5 DD-LMS \u03B4\u03B9\u03BF\u03C1\
      \u03B8\u03C9\u03C4\u03AE. \u039C\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\
      \u03BF \u03BC = \u03C4\u03B1\u03C7\u03CD\u03C4\u03B5\u03C1\u03B7 \u03C0\u03B1\
      \u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B7 \u03C6\u03AC\
      \u03C3\u03B7\u03C2/\u03BA\u03AD\u03C1\u03B4\u03BF\u03C5\u03C2 \u03B1\u03BB\u03BB\
      \u03AC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2\
      \ \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF\u03C2 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\
      \u03B5\u03C9\u03BD. \u03A4\u03C5\u03C0\u03B9\u03BA\u03AC 0.03-0.10."
    gui_hint: 3,0,1,4
    label: "DD-LMS \u03BC"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.2'
    value: '0.05'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 300]
    rotation: 0
    state: enabled
