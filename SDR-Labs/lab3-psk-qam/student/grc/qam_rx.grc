    rotation: 0
    state: enabled
- name: costas_bw_div
  id: variable_qtgui_range
  parameters:
    comment: "ΖΩΝΤΑΝΗ ρύθμιση του εύρους
      βρόχου Costas (= 2π/N). Το 16-QAM έχει
      αντικρουόμενες απαιτήσεις: (α) ΣΤΕΝΟΣ
      βρόχος (μεγάλο N) φιλτράρει τον θόρυβο
      σχηματισμού των 12 μη-γωνιακών σημείων
      (μόνο τα 4 γωνιακά «μοιάζουν» με QPSK
      στον ανιχνευτή 4ης τάξης)· (β) ΦΑΡΔΥΣ
      βρόχος (μικρό N) παρακολουθεί τον
      θόρυβο φάσης των πραγματικών
      ταλαντωτών HackRF/RTL-SDR. Πολύ μεγάλο
      N -> τα σημεία «σέρνονται» σε τόξα
      (ο αστερισμός λικνίζεται)· πολύ μικρό
      N -> θολά, φουσκωμένα σημεία. Βρείτε
      το βέλτιστο ΖΩΝΤΑΝΑ παρατηρώντας
      το EVM — εξαρτάται από τα πραγματικά
      radios, δεν προσομοιώνεται!"
    gui_hint: 2,2,1,2
    label: "Costas N (εύρος = 2π/N)"
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '50'
    step: '25'
    stop: '2000'
    value: '300'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 300]
    rotation: 0
    state: enabled
