options:
  parameters:
    author: K510 Digital Communications Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'RTL-SDR OOK/Morse receiver: envelope detect -> decimate to 32 kHz -> AGC -> Schmitt threshold -> recovered bit, Morse tape (time raster) + audible tone (lab2-ook-fsk).'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ook_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OOK / Morse Receiver (RTL-SDR)
    window_size: (1300,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: RTL-SDR sample rate
    value: '2048000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 12
    rotation: 0
    state: enabled
- name: env_decim
  id: variable
  parameters:
    comment: 'Αποδεκατισμός του περιβλήματος μετά τον ανιχνευτή: 2.048 Msps / 64 = 32 kHz'
    value: '64'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 100
    rotation: 0
    state: enabled
- name: env_rate
  id: variable
  parameters:
    comment: Ρυθμός περιβλήματος / AGC / κατωφλίου (32 kHz)
    value: samp_rate/env_decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 180
    rotation: 0
    state: enabled
- name: tape_spu
  id: variable
  parameters:
    comment: Δείγματα ανά unit στην «Ταινία Morse» (σταθερά, ανεξάρτητα από τον ρυθμό)
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 136
    - 100
    rotation: 0
    state: enabled
- name: tape_units
  id: variable
  parameters:
    comment: Units Morse ανά γραμμή της «Ταινίας Morse»
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 136
    - 180
    rotation: 0
    state: enabled
- name: freq
  id: variable_qtgui_range
  parameters:
    comment: Κεντρική συχνότητα RTL-SDR
    gui_hint: 0,0,1,1
    label: Συχνότητα συντονισμού (MHz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '433.82'
    step: '0.001'
    stop: '434.02'
    value: '433.92'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 136
    - 12
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: Κέρδος (gain) του RTL-SDR
    gui_hint: 0,1,1,1
    label: Κέρδος RF (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '49'
    value: '30'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 264
    - 12
    rotation: 0
    state: enabled
- name: bit_rate
  id: variable_qtgui_chooser
  parameters:
    comment: Πρέπει να ταιριάζει με τον ρυθμό Morse του εκπομπού
    gui_hint: 0,2,1,1
    label: Ρυθμός Morse (baud)
    label0: '500'
    label1: '1000'
    label2: '2000'
    label3: '4000'
    label4: '50'
    labels: '[]'
    num_opts: '5'
    option0: '500'
    option1: '1000'
    option2: '2000'
    option3: '4000'
    option4: '50'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: int
    value: '1000'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 392
    - 12
    rotation: 0
    state: enabled
- name: thresh_lo
  id: variable_qtgui_range
  parameters:
    comment: Κατώφλι Schmitt-trigger (ΧΑΜΗΛΟ) πάνω στο περίβλημα (envelope) μετά το AGC
    gui_hint: 0,3,1,1
    label: Κατώφλι ΧΑΜΗΛΟ
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.02'
    stop: '1.5'
    value: '0.3'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 12
    rotation: 0
    state: enabled
- name: thresh_hi
  id: variable_qtgui_range
  parameters:
    comment: Κατώφλι Schmitt-trigger (ΥΨΗΛΟ)
    gui_hint: 0,4,1,1
    label: Κατώφλι ΥΨΗΛΟ
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.02'
    stop: '1.5'
    value: '0.6'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 648
    - 12
    rotation: 0
    state: enabled
- name: audio_on
  id: variable_qtgui_check_box
  parameters:
    comment: Ξεσίγαση του ακουστικού τόνου CW
    'false': '0'
    gui_hint: 0,5,1,1
    label: Ήχος ενεργός
    'true': '1'
    type: int
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 776
    - 12
    rotation: 0
    state: enabled
