- name: ascii_decoder_0
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      import numpy as np
      from gnuradio import gr
      import pmt
      import codecs


      PREAMBLE = 0xAAAA7E  # 0xAA 0xAA 0x7E ως 24-bit ακέραιος (MSB πρώτα)
      PREAMBLE_INV = (~PREAMBLE) & 0xFFFFFF  # ίδιο preamble με αντεστραμμένη πολικότητα bit
      PREAMBLE_MASK = 0xFFFFFF


      class blk(gr.sync_block):
          """Αποκωδικοποιητής πλαισίου FSK -> ASCII/UTF-8.

          Είσοδος: 1 δείγμα/bit (0.0/1.0), ήδη ευθυγραμμισμένο στον ρυθμό bit
          από την ανάκτηση χρονισμού (Clock Recovery MM) πριν από αυτό το block.
          Αναζητά το preamble 0xAA 0xAA 0x7E σε ένα κυλιόμενο παράθυρο 24 bits —
          ΚΑΙ την αντεστραμμένη εκδοχή του (PREAMBLE_INV), γιατί η πολικότητα
          mark/space (ποιο bit αντιστοιχεί σε υψηλότερη/χαμηλότερη συχνότητα στην
          έξοδο του quadrature demod) δεν είναι εγγυημένη a priori: αν βρεθεί η
          ανεστραμμένη εκδοχή, όλα τα επόμενα bits αντιστρέφονται πριν τη
          συσκευασία σε bytes. Χωρίς αυτόν τον έλεγχο, μια απλή global
          αντιστροφή πολικότητας θα εμπόδιζε ΚΑΘΕ συγχρονισμό (καμία εμφάνιση
          κειμένου, ποτέ) παρότι το ανακτημένο bit φαίνεται μια χαρά στο
          παλμογράφο — αυτό ακριβώς παρατηρήθηκε τεστάροντας το lab.

          Μόλις συγχρονιστεί, συγκεντρώνει τα επόμενα bits σε bytes (MSB
          πρώτα), τα οποία αποκωδικοποιεί σταδιακά ως UTF-8 μέσω ενός
          incremental decoder (codecs) — απαραίτητο γιατί οι ελληνικοί
          χαρακτήρες είναι πολυ-byte UTF-8 ακολουθίες και δεν μπορούν να
          αποκωδικοποιηθούν byte-byte ανεξάρτητα. Δημοσιεύει το συσσωρευμένο
          κείμενο σε κάθε νέο byte μέσω μηνύματος (message port 'text') προς
          ένα QT GUI Message Edit Box, ώστε οι φοιτητές να βλέπουν το μήνυμα
          να «χτίζεται» χαρακτήρα-χαρακτήρα σε πραγματικό χρόνο. Κάθε νέο
          preamble (δηλ. κάθε επανάληψη εκπομπής) καθαρίζει και ξαναρχίζει.

          Τρέχει στον (χαμηλό) ρυθμό bit, όχι στον πλήρη ρυθμό δειγματοληψίας
          του RTL-SDR — άρα ένα Python epy_block εδώ δεν κινδυνεύει από το
          πρόβλημα ανταγωνισμού GIL/υποδοχέα υλικού που παρατηρήθηκε στο
          ook_tx.grc (εκεί το πρόβλημα ήταν streaming source σε πραγματικό
          χρόνο τροφοδοτώντας απευθείας το HackRF TX sink).
          """

          def __init__(self):
              gr.sync_block.__init__(
                  self,
                  name='Αποκωδικοποιητής ASCII',
                  in_sig=[np.float32],
                  out_sig=[],
              )
              self.message_port_register_out(pmt.intern('text'))
              self._reg = 0
              self._decoder = None
              self._byte_bits = []
              self._text = ''
              self._invert = False

          def _publish(self):
              self.message_port_pub(pmt.intern('text'), pmt.intern(self._text))

          def work(self, input_items, output_items):
              bits = input_items[0]
              for sample in bits:
                  raw_bit = 1 if sample > 0.5 else 0
                  self._reg = ((self._reg << 1) | raw_bit) & PREAMBLE_MASK
                  if self._reg == PREAMBLE or self._reg == PREAMBLE_INV:
                      self._invert = (self._reg == PREAMBLE_INV)
                      self._decoder = codecs.getincrementaldecoder('utf-8')()
                      self._byte_bits = []
                      self._text = ''
                      self._publish()
                      continue
                  if self._decoder is None:
                      continue
                  bit = (raw_bit ^ 1) if self._invert else raw_bit
                  self._byte_bits.append(bit)
                  if len(self._byte_bits) == 8:
                      value = 0
                      for b in self._byte_bits:
                          value = (value << 1) | b
                      self._byte_bits = []
                      try:
                          chars = self._decoder.decode(bytes([value]))
                      except UnicodeDecodeError:
                          self._decoder = codecs.getincrementaldecoder('utf-8')()
                          chars = ''
                      if chars:
                          self._text += chars
                          self._publish()
              return len(bits)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1352
    - 640
    rotation: 0
    state: enabled
